# Inspects the filesystem on the current VFS target.
#
# `metadata` dumps everything Do can report about a path: ordinary metadata,
# platform attributes, ACLs, extended attributes, Windows security descriptors
# and alternate data streams, and the containing filesystem.
#
# The layout is YAML-shaped, so ACL entries and security descriptors read
# roughly the way the corresponding `security` module spec would be written.

import admin args fs fs.unix fs.windows sys term time uuid
import security.macos security.unix security.windows
import _display: display

let head_style = term.style bold: true
let error_style = term.style fg: :BRIGHT_RED: bold: true

# Metadata fields that belong to each section, in the order they are printed.
# Anything the runtime reports that isn't listed here is a platform attribute
# (if boolean) or lands in a trailing `other` section, so a field added to
# `fs.Metadata` later still shows up without touching this file.
let GENERAL_FIELDS = ["type", "size", "modified", "accessed", "created"]
let UNIX_FIELDS = $
  - mode
  - uid
  - gid
  - nlink
  - ino
  - dev
  - rdev
  - blksize
  - blocks
# Raw platform bitmasks, printed in hex wherever they turn up. `win_flags` is
# an `FsMetadata` field; the rest are on both types.
let RAW_MASK_FIELDS = $
  - linux_attrs
  - macos_attrs
  - freebsd_attrs
  - win_attrs
  - win_flags
# `owner`/`group` are `Metadata`'s portable view of ownership, and duplicate
# whatever the platform reports in full: `uid`/`gid` in the unix section, the
# owner and group SIDs in the security descriptor.
let SKIP_FIELDS = ["owner", "group"]
let FS_FIELDS = $
  - capacity
  - free
  - available
  - block_size
  - read_only
  - name_max

let MAX_DEPTH = 6

# Windows ACE types, grouped by the spec key that names their trustee.
let WINDOWS_ALLOW = $
  - :ACCESS_ALLOWED:
  - :ACCESS_ALLOWED_OBJECT:
  - :ACCESS_ALLOWED_CALLBACK:
  - :ACCESS_ALLOWED_CALLBACK_OBJECT:
  - :ACCESS_ALLOWED_COMPOUND:
let WINDOWS_DENY = $
  - :ACCESS_DENIED:
  - :ACCESS_DENIED_OBJECT:
  - :ACCESS_DENIED_CALLBACK:
  - :ACCESS_DENIED_CALLBACK_OBJECT:
let WINDOWS_AUDIT = $
  - :SYSTEM_AUDIT:
  - :SYSTEM_AUDIT_OBJECT:
  - :SYSTEM_AUDIT_CALLBACK:
  - :SYSTEM_AUDIT_CALLBACK_OBJECT:

# --- Value conversion -------------------------------------------------------
#
# Everything reported about a path is rendered by turning it into a `display`
# node: a value that reads better as a single line becomes a leaf, and anything
# else is destructured into its fields or iterated into a list.

# True when `value` is a flag-set-shaped iterable rather than a sequence of
# structured values.
def all_syms items
  if (items.len == 0)
    return false
  for item = items
    if !(type item Sym)
      return false
  true

# Destructures an object into its fields. Answers `nil` for a value that
# doesn't unpack into key/value pairs at all.
def unpack_pairs value depth
  try
    bind value
      ...rest
    let entries = []
    for item = rest
      let key item_value = item
      entries.push [str key, node item_value (depth + 1)]
    entries
  catch std.RuntimeError: _
    nil

# Materializes an iterable, or answers `nil` when the value isn't one.
def collect value
  try
    let items = []
    for item = value
      items.push $item
    items
  catch std.RuntimeError: _
    nil

def structure_node value depth
  let entries = unpack_pairs $value $depth
  if (entries != nil && entries.len > 0)
    return display.Map $entries
  let raw = collect $value
  if (raw == nil)
    return display.text $value
  if all_syms(raw)
    return display.flags $raw
  display.List $
    for item = raw
      - $ node $item (depth + 1)

# Converts an arbitrary value into a node, special-casing the types that
# read better as a single line than as their component fields.
def node value depth = 0
  if (value == nil)
    return display.text nil
  if (depth > MAX_DEPTH)
    return display.text $value
  if ((type value Sym) || (type value Bool))
    return display.enum $value
  if ((type value Int) || (type value Float) || (type value Str))
    return display.text $value
  if ((type value time.DateTime) || (type value fs.Path) || (type value uuid.Uuid))
    return display.text $value
  if (type value Bin)
    return display.Scalar "<$(value.len) bytes>"
  if (type value fs.unix.Mode)
    return mode_node $value
  if (type value security.windows.Sid)
    return display.sid $value
  structure_node $value $depth

# --- Leaf formatting --------------------------------------------------------

# `rwx`, with the set-uid/set-gid/sticky bit folded into the execute slot the
# way `ls` writes it.
def triad permissions special special_char
  let r = (permissions.contains(:READ:) && "r" || "-")
  let w = (permissions.contains(:WRITE:) && "w" || "-")
  let executable = permissions.contains(:EXECUTE:)
  let x = if special
    (executable && special_char || special_char.upper)
  else
    (executable && "x" || "-")
  "$r$w$x"

def mode_node mode
  let owner = triad $mode.owner $mode.contains(:SET_UID:) s
  let group = triad $mode.group $mode.contains(:SET_GID:) s
  let other = triad $mode.other $mode.contains(:STICKY:) t
  display.Scalar "0$((mode.int & 0o7777).octal())" "$owner$group$other"

def hex_node value
  if (value == nil)
    return display.text nil
  display.Scalar "0x$(value.hex())"

def uuid_node principal
  let name = display.opt do
    let kind id = security.macos.id_for_uuid $principal
    let resolved = display.opt do
      if (kind == :UID:)
        security.unix.user_name $id
      else
        security.unix.group_name $id
    if resolved
      "$(kind.lower) $id ($resolved)"
    else
      "$(kind.lower) $id"
  display.text $principal $name

# --- Access control entries -------------------------------------------------
#
# Each of these renders an entry as the declarative spec its module accepts,
# so a dump can be read back as the thing that would recreate it.

def posix_ace_node ace
  let kind = ace.type
  let permissions = display.flags $ace.permissions
  if (kind == :USER_OBJ:)
    return display.Map [["user_obj", permissions]]
  if (kind == :GROUP_OBJ:)
    return display.Map [["group_obj", permissions]]
  if (kind == :MASK:)
    return display.Map [["mask", permissions]]
  if (kind == :OTHER:)
    return display.Map [["other", permissions]]
  let key = ((kind == :USER:) && "user" || "group")
  display.Map $
    - [key, display.id ace.id kind]
    - ["permissions", permissions]

def nfs4_ace_node ace
  let key = if (ace.type == :ALLOW:)
    "allow"
  else if (ace.type == :DENY:)
    "deny"
  else if (ace.type == :AUDIT:)
    "audit"
  else
    "alarm"
  let principal = ace.principal
  let trustee = if (principal == :USER:)
    display.Map [["user", display.id ace.id :USER:]]
  else if (principal == :GROUP:)
    display.Map [["group", display.id ace.id :GROUP:]]
  else
    display.enum $principal
  let entries = [[key, trustee], ["mask", display.flags ace.mask]]
  let flags = collect $ace.flags
  if (flags != nil && flags.len > 0)
    entries.push ["flags", display.flags flags]
  display.Map $entries

def macos_ace_node ace
  let key = ((ace.type == :ALLOW:) && "allow" || "deny")
  let entries = $
    - [key, uuid_node ace.principal]
    - ["mask", display.flags ace.mask]
  let flags = collect $ace.flags
  if (flags != nil && flags.len > 0)
    entries.push ["flags", display.flags flags]
  display.Map $entries

def windows_ace_node ace
  let entries = []
  let kind = ace.type
  let sid = display.opt do ace.sid
  let key = if WINDOWS_ALLOW.contains(kind)
    "allow"
  else if WINDOWS_DENY.contains(kind)
    "deny"
  else if WINDOWS_AUDIT.contains(kind)
    "audit"
  else
    nil
  if (key != nil && sid != nil)
    entries.push [key, display.sid sid]
  else
    entries.push ["type", display.enum kind]
    if (sid != nil)
      entries.push ["sid", display.sid sid]
  let mask = display.opt do ace.mask
  if (mask != nil)
    entries.push ["mask", display.flags mask]
  let flags = display.opt do collect(ace.flags)
  if (flags != nil && flags.len > 0)
    entries.push ["flags", display.flags flags]
  let object_type = display.opt do ace.object_type
  if (object_type != nil)
    entries.push ["object_type", node object_type]
  let inherited_object_type = display.opt do ace.inherited_object_type
  if (inherited_object_type != nil)
    entries.push ["inherited_object_type", node inherited_object_type]
  if (key == "audit")
    entries.push ["successful", node (display.opt do ace.successful_access)]
    entries.push ["failed", node (display.opt do ace.failed_access)]
  let data = display.opt do ace.application_data
  if (data != nil && data.len > 0)
    entries.push ["application_data", node data]
  display.Map $entries

# Renders an ACL's entries as a list of specs, dispatching on the flavor the
# ACL was fetched as.
def acl_node acl kind
  display.List $
    for ace = acl.aces
      if (kind == :POSIX:)
        - $ posix_ace_node $ace
      else if (kind == :NFS4:)
        - $ nfs4_ace_node $ace
      else if (kind == :MACOS:)
        - $ macos_ace_node $ace
      else
        - $ windows_ace_node $ace

# --- Windows security descriptors -------------------------------------------

def sec_desc_node desc
  let entries = []
  let revision = display.opt do desc.revision
  if (revision != nil)
    entries.push ["revision", node revision]
  let control = display.opt do desc.control
  if (control != nil)
    entries.push ["control", display.flags control]
  let owner = display.opt do desc.owner
  if (owner != nil)
    entries.push ["owner", display.sid owner]
  let group = display.opt do desc.group
  if (group != nil)
    entries.push ["group", display.sid group]
  let dacl = display.opt do desc.dacl
  if (dacl != nil)
    entries.push ["dacl", acl_node dacl :WINDOWS:]
  let sacl = display.opt do desc.sacl
  if (sacl != nil)
    entries.push ["sacl", acl_node sacl :WINDOWS:]
  let rm_control = display.opt do desc.rm_control
  if (rm_control != nil)
    entries.push ["rm_control", node rm_control]
  display.Map $entries

# --- Sections ---------------------------------------------------------------

# Reorders `entries` to follow `wanted`, keeping anything unlisted in the
# order it arrived. Objects report their fields in registration order, which
# isn't always the order that reads best.
def order_entries wanted entries
  let ordered = []
  for name = wanted
    for entry = entries
      if (entry[0] == name)
        ordered.push $entry
  for entry = entries
    if !wanted.contains(entry[0])
      ordered.push $entry
  ordered

# Splits `fs.Metadata` into the general/unix/attribute groups. Every reported
# field lands somewhere: unrecognized booleans are treated as platform
# attributes, and anything else falls through to `other`.
def metadata_sections meta all
  let general = []
  let unix = []
  let attributes = []
  let other = []
  bind meta
    ...rest
  for name value = rest
    let key = (str name)
    if SKIP_FIELDS.contains(key)
      continue
    if GENERAL_FIELDS.contains(key)
      general.push [key, node value]
    else if UNIX_FIELDS.contains(key)
      if (key == "uid")
        unix.push [key, display.id value :USER:]
      else if (key == "gid")
        unix.push [key, display.id value :GROUP:]
      else
        unix.push [key, node value]
    else if RAW_MASK_FIELDS.contains(key)
      # A raw attribute mask reads as `nil` when the filesystem or file type
      # can't be asked for one, which is the common case for symlinks.
      if (value != nil || all)
        attributes.push [key, hex_node value]
    else if ((type value Bool) || (value == nil))
      # Platform attribute flags: `false` when the file doesn't have the
      # attribute, `nil` when this filesystem can't be asked about it.
      if ((value == true) || all)
        attributes.push [key, node value]
    else
      other.push [key, node value]
  let general_ordered = order_entries $GENERAL_FIELDS $general
  let unix_ordered = order_entries $UNIX_FIELDS $unix
  [general_ordered, unix_ordered, attributes, other]

def link_section path meta
  if (meta.type != :SYMLINK:)
    return nil
  let target = display.opt do fs.read_link $path
  if (target == nil)
    return nil
  display.Map [["target", node target]]

def acl_section path kind default resolve
  let acl = display.opt do
    fs.acl $path kind: $kind default: $default resolve: $resolve
  if (acl == nil)
    return nil
  acl_node $acl $kind

def xattr_section path resolve
  let listing = display.opt do
    [...fs.xattrs path namespace: :ANY: resolve: resolve]
  let attrs = if (listing == nil)
    display.opt do
      [...fs.xattrs path resolve: resolve]
  else
    listing
  if (attrs == nil)
    return nil
  let entries = []
  for attr = attrs
    let namespace = display.opt do attr.namespace
    let name = if (namespace == nil)
      attr.name
    else
      "$namespace.$(attr.name)"
    let size = display.opt do attr.size
    let value = if (size == nil)
      let raw = display.opt do
        fs.xattr $path $attr.name namespace: $namespace resolve: $resolve
      (raw != nil && raw.len || nil)
    else
      size
    if (value == nil)
      entries.push [name, display.text nil]
    else
      entries.push [name, display.Scalar "$value bytes"]
  display.Map $entries

def sec_desc_section path resolve
  # Reading a SACL needs SE_SECURITY_NAME, and asking for one without it fails
  # the whole fetch rather than just that component, so only ask when elevated.
  let elevated = display.opt do admin.query()
  let sacl = (elevated == true)
  let desc = display.opt do
    fs.windows.sec_desc $path sacl: $sacl resolve: $resolve
  if (desc == nil)
    return nil
  sec_desc_node $desc

def stream_section path resolve
  # The default stream is always enumerated first, and only repeats the file's
  # own size, so skip it; a file with no alternate streams then has nothing to
  # report and the section drops out.
  let streams = display.opt do
    [...(fs.streams path resolve: resolve).skip(1)]
  if (streams == nil)
    return nil
  display.Map $
    for stream = streams
      - [str stream.name, stream_node stream]

# A stream's own `name` is the key it is filed under, so drop it from the body.
def stream_node stream
  let nd = node $stream
  if !(type nd display.Map)
    return nd
  display.Map $
    for entry = nd.entries
      if (entry[0] != "name")
        - $entry

def filesystem_section path
  let fs_meta = display.opt do fs.fs_metadata $path
  if (fs_meta == nil)
    return nil
  let entries = []
  bind fs_meta
    ...rest
  for name value = rest
    let key = (str name)
    if RAW_MASK_FIELDS.contains(key)
      entries.push [key, hex_node value]
    else
      entries.push [key, node value]
  display.Map $ order_entries $FS_FIELDS $entries

# --- Driver -----------------------------------------------------------------

def dump path resolve all
  let meta = fs.metadata $path resolve: $resolve
  let general unix attributes other = metadata_sections $meta $all
  let os = display.opt do sys.os_info().os

  display.section general $ display.Map $general
  display.section link $ link_section $path $meta
  display.section unix $ display.Map $unix
  display.section attributes $ display.Map $attributes
  display.section other $ display.Map $other

  display.section acl $ acl_section $path :POSIX: false $resolve
  if (meta.type == :DIR:)
    display.section "default acl" $ acl_section $path :POSIX: true $resolve
  if (os == :FREEBSD:)
    display.section "nfs4 acl" $ acl_section $path :NFS4: false $resolve
  if (os == :MACOS:)
    display.section "macos acl" $ acl_section $path :MACOS: false $resolve
  if (os == :WINDOWS:)
    display.section "security descriptor" $ sec_desc_section $path $resolve
    display.section streams $ stream_section $path $resolve

  display.section xattrs $ xattr_section $path $resolve
  display.section filesystem $ filesystem_section $path

def dump_metadata p
  let opts = p.metadata
  if (opts.paths.len == 0)
    throw args.Error "expected at least one path"
  let resolve = (opts.link && :LINK: || :TARGET:)
  let rc = 0
  let first = true
  for path = opts.paths
    if !first
      echo()
    first = false
    print (head_style "● $path")
    echo()
    try
      dump $path $resolve $opts.all
    catch std.RuntimeError: e
      # One bad path shouldn't abandon the rest; report it and carry on.
      rc = 1
      print "  " (error_style "error") ": "
      echo $ str $e
  exit $rc

args.with
  help: Inspect the filesystem.
  - cmd: metadata
    help: Dump metadata, access control, and extended attributes for a path.
    - flag: link
      short: L
      help: Report on a symlink itself rather than its target
    - flag: all
      short: a
      help: Include platform attributes that are not set
    - arg: paths
      parse: $fs.Path
      collect: true
      help: Paths to inspect
    $dump_metadata
