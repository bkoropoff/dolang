# Inspects and controls processes on the current VFS target.

import args fs proc shell std term
import _display: display

let heading_style = term.style fg: :BRIGHT_BLUE: bold: true
let pid_style = term.style fg: :CYAN: bold: true
let dim_style = term.style dim: true
let absent_style = term.style dim: true
let error_style = term.style fg: :BRIGHT_RED: bold: true

# This is a byte limit, not terminal width. Proper clipping needs Unicode
# grapheme segmentation and terminal-cell measurement.
let MAX_ARGV0_NAME_BYTES = 128

def parse_pid value
  let pid = try
    int $value
  catch std.RuntimeError: _
    throw args.Error "invalid PID: $value"
  if (pid < 0)
    throw args.Error "invalid PID: $value"
  pid

def parse_signal value
  sym $ value.upper()

def pad_left value width
  "$(" ".repeat(width - value.len))$value"

def pad_right value width
  "$value$(" ".repeat(width - value.len))"

def process_name info
  let exe = info.exe
  if (exe != nil)
    let name = exe.name
    if (name != nil && name.len > 0)
      return name
  let cmdline = info.cmdline
  if (cmdline != nil && cmdline.len > 0 &&
      cmdline[0].len > 0 && cmdline[0].len <= MAX_ARGV0_NAME_BYTES)
    let name = (fs.Path cmdline[0]).name
    if (name != nil && name.len > 0)
      return name
  info.name

def list_processes _p
  let rows = []
  let pid_width = 3
  let ppid_width = 4
  let name_width = 4
  for info = proc.enumerate()
    let pid = str $info.pid
    let ppid = (info.parent_pid != nil && str(info.parent_pid) || "~")
    let name = process_name $info
    rows.push [pid, ppid, name]
    if (pid.len > pid_width)
      pid_width = pid.len
    if (ppid.len > ppid_width)
      ppid_width = ppid.len
    if (name.len > name_width)
      name_width = name.len

  print (heading_style(pad_left("PID", pid_width))) "  "
  print (heading_style(pad_left("PPID", ppid_width))) "  "
  print (heading_style(pad_right("NAME", name_width))) "\n"
  for row = rows
    let pid ppid name = row
    print (pid_style(pad_left(pid, pid_width))) "  "
    let ppid_cell = pad_left $ppid $ppid_width
    if (ppid == "~")
      print $ absent_style $ppid_cell
    else
      print $ppid_cell
    print "  " $ pad_right $name $name_width
    print "\n"

def unix_node identity
  let groups = display.List $
    for gid = identity.groups
      - $ display.id $gid :GROUP:
  display.Map $
    - ["uid", display.id identity.uid :USER:]
    - ["gid", display.id identity.gid :GROUP:]
    - ["euid", display.id identity.euid :USER:]
    - ["egid", display.id identity.egid :GROUP:]
    - ["groups", groups]

def token_node token
  let groups = display.List $
    for group = token.groups
      $ display.Map $
        - ["sid", display.sid group.sid]
        - ["attributes", display.flags group.attributes]
  display.Map $
    - ["elevated", display.enum token.is_elevated]
    - ["user_sid", display.sid token.user_sid]
    - ["owner_sid", display.sid token.owner_sid]
    - ["primary_group_sid", display.sid token.primary_group_sid]
    - ["logon_sid", display.sid token.logon_sid]
    - ["groups", groups]

# Renders the argument vector, distinguishing an absent one from an empty one.
#
# A `List` built from no arguments is empty, so building the node
# unconditionally would render a command line the target could not report the
# same as one that is genuinely empty.
def cmdline_node info
  if (info.cmdline == nil)
    return display.text nil
  display.List $
    for arg = info.cmdline
      - $ display.text $arg

# Describes how a process ended, or that it has not.
def status_text info
  let status = info.status
  if (status == nil)
    return "running"
  if (status.code != nil)
    return "exited ($(status.code))"
  "exited"

def dump_info info
  # A process that has exited is still described, because the kernel keeps its
  # PID, parent and start time — but everything below is read out of an address
  # space that no longer exists, so for such a process an absence is expected
  # rather than informative, and only a field that survived earns a row.
  let ended = (info.status != nil)
  print (heading_style "● process $(info.pid)") "\n"
  let general_rows = []
  if (info.name.len > 0)
    general_rows.push ["name", display.text info.name]
  general_rows.push ["status", display.text (status_text info)]
  general_rows.push ["parent_pid", display.text info.parent_pid]
  if (!ended || info.exe != nil)
    general_rows.push ["exe", display.text info.exe]
  if (!ended || info.cwd != nil)
    general_rows.push ["cwd", display.text info.cwd]
  if (!ended || info.cmdline != nil)
    general_rows.push ["cmdline", cmdline_node info]
  # Windows keeps the command line as one string and the split above is a
  # reconstruction of it, so show the original where there is one.
  let raw = display.opt do info.cmdline_win
  if (raw != nil)
    general_rows.push ["cmdline_win", display.text raw]
  display.section general $ display.Map $general_rows

  let identity = display.opt do info.unix_id
  if (identity != nil)
    display.section "unix identity" $ unix_node $identity
  let token = display.opt do info.token_info
  if (token != nil)
    display.section "windows token" $ token_node $token

def info_processes p
  if (p.info.pids.len == 0)
    throw args.Error "expected at least one PID"
  let rc = 0
  let first = true
  for pid = p.info.pids
    if !first
      print "\n"
    first = false
    try
      dump_info $ proc.info $pid
    catch std.RuntimeError: e
      rc = 1
      print (error_style "● $pid") ": " (str e) "\n"
  shell.exit $rc

def terminate_processes p
  let opts = p.term
  if (opts.pids.len == 0)
    throw args.Error "expected at least one PID"
  if (opts.kill && opts.signal != nil)
    throw args.Error "--kill and --signal are mutually exclusive"
  for pid = opts.pids
    proc.open $pid do |process|
      if (opts.signal != nil)
        process.signal $opts.signal
        print (dim_style "•") " sent $(opts.signal) to " (pid_style pid) "\n"
      else if opts.kill
        process.kill()
        print (dim_style "•") " killed " (pid_style pid) "\n"
      else
        process.terminate()
        print (dim_style "•") " terminated " (pid_style pid) "\n"
      if opts.wait
        let status = process.wait()
        print "  " (dim_style "↳") " exited" \
          (status.code != nil && " with status $(status.code)" || "") "\n"

args.with
  help: Inspect and control processes.
  - cmd: list
    help: List processes in a compact portable table.
    $list_processes
  - cmd: info
    help: Dump detailed information for one or more processes.
    - arg: pids
      parse: $parse_pid
      collect: true
      help: Process IDs to inspect
    $info_processes
  - cmd: term
    help: Terminate one or more processes.
    - flag: kill
      short: k
      help: Kill aggressively instead of requesting termination
    - opt: signal
      short: s
      parse: $parse_signal
      default: nil
      meta: SIGNAL
      help: Send an explicit Unix signal (for example TERM or HUP)
    - flag: wait
      short: w
      help: Wait for each process to exit
    - arg: pids
      parse: $parse_pid
      collect: true
      help: Process IDs to terminate
    $terminate_processes
