# Runner provisioning for the setup-runner action.
#
# `setup` is the whole of it: it installs the `dolang-ci` wrapper and whatever
# build prerequisites the target needs, either on the runner itself or in a CI
# VM created for the job. Runner logs are not a terminal, so its progress
# indicators render as plain step lines.

import cache fs http libvirt proc progress sudo sys
import std:
  - NULLITER

# Libvirt domain name for the CI VM.
pub let VM_NAME = "dolang-ci"

# The one target that builds in a VM rather than on the runner.
let VM_TARGET = "x86_64-freebsd"

# Application name scoping the VM's cached assets. The runner cache paths in
# ../action.yml are derived from it.
let VM_APP = "dolang-freebsd-ci"

# The raw image rather than the qcow2 one: the domain disk is a qcow2 overlay
# either way, and a raw backing file spares every overlay read miss a second
# layer of qcow2 cluster translation. The two downloads are within 0.2% of the
# same size, though the raw one decompresses to the image's full virtual size.
let VM_IMAGE = "https://download.freebsd.org/releases/VM-IMAGES/15.1-RELEASE/amd64/Latest/FreeBSD-15.1-RELEASE-amd64-BASIC-CLOUDINIT-ufs.raw.xz"

# Directories worth reclaiming on the runner before staging a VM image.
let RUNNER_BALLAST = $
  - /usr/local/lib/android
  - /usr/share/dotnet

# Pinned bootstrap release, shared with the setup-dolang action.
let VERSION_FILE = ".github/dolang-version"

let PROGRESS_STYLE = $
  message:
    width: 120

# The guest's `~/.profile`, which is what puts the Rust toolchain on `PATH`.
#
# `dolang-vfs` reconstructs a login environment by running the account's login
# shell (see `ssh.with`), so this file — not the environment of any one
# command — is what every later build step inherits.
#
# Written during provisioning rather than left to rustup's own `PATH` edit, so
# that it is a fact about the guest either way: a run whose toolchain came from
# a restored cache never executes the installer at all, and would otherwise
# have a `cargo` on disk that nothing could resolve.
# Spelled out in full rather than prepending to whatever `PATH` arrives,
# because writing this file replaces the base image's own `.profile`: the
# `pkg`-installed build prerequisites live in `/usr/local/bin`, which an
# inherited `PATH` from `sshd` is not guaranteed to include.
pub let PROFILE = r|
  PATH="$HOME/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  export PATH

# Reads the pinned Dolang release tag from the checked out workspace.
def dolang_version()
  fs.read(VERSION_FILE).trim()

# Exports `name=value` to subsequent steps of the job.
def export name value
  fs.append $env["GITHUB_ENV"] "$name=$value\n"

# Runs `block` under its own indicator nested beneath `parent`, then advances
# `parent` by one step.
def step parent icon message block
  progress.show :icon :message do |_|
    block()
  parent.delta()

# Installs the `dolang-ci` wrapper, which runs `shell` (the workflow shell
# dispatcher next door) on each step script, and puts it on `PATH` for the
# rest of the job.
def install_wrapper shell
  let bin_dir = (fs.Path(env["RUNNER_TEMP"]) / "dolang-ci-bin")
  bin_dir.create_dir all: true

  if (sys.os_info().family == :WINDOWS:)
    fs.write (bin_dir / "dolang-ci.cmd") |
      @echo off
      dolang "$shell" %*
      exit /b %errorlevel%
  else
    let wrapper = (bin_dir / "dolang-ci")
    fs.write $wrapper |
      #!/bin/sh
      exec dolang "$shell" "\$@"
    fs.set_metadata mode: 0o755 $wrapper

  fs.append $env["GITHUB_PATH"] "$bin_dir\n"

# Trims debug info generation for every CI build.
#
# Full debug info costs compile time, link time, and disk on every runner, and
# nothing in CI keeps the artifacts for offline analysis — no core files are
# scraped off a runner before it is destroyed. `line-tables-only` is the least
# that still gives a panic or crash backtrace file and line numbers; symbol
# names come from the symbol table, so those survive regardless.
#
# The VM target needs these forwarded into the guest as well; `VM_ENV` in
# shell.dol next door lists them.
def configure_cargo()
  export CARGO_PROFILE_DEV_DEBUG line-tables-only
  export CARGO_PROFILE_TEST_DEBUG line-tables-only

# Installs the Rust build prerequisites on the runner itself.
def host_prereqs w
  let os = sys.os_info().os

  if (os == :MACOS:)
    step $w 📦 "install llvm" do
      run brew install llvm
      export LIBCLANG_PATH /opt/homebrew/opt/llvm/lib
  else if (os == :LINUX:)
    step $w 📦 "install llvm" do
      sudo.with do
        run apt update
        run apt install llvm libclang-dev
    # `dodo install` links dolang-vfs against musl
    step $w 🦀 "add musl target" do
      run rustup target add x86_64-unknown-linux-musl

# Steps `host_prereqs` reports on the runner it is running on.
def host_prereq_steps()
  let os = sys.os_info().os
  if (os == :LINUX:)
    2
  else if (os == :MACOS:)
    1
  else
    0

# Installs the virtualization packages a session-mode libvirt domain needs.
def install_virt()
  sudo.with do
    run apt-get update
    run apt-get install -y
      libvirt-daemon-system libvirt-clients qemu-system-x86 qemu-utils
      passt cloud-image-utils openssh-client apparmor-utils

# Grants KVM access and unconfines user namespaces enough for session-mode
# libvirt to start a domain.
def unconfine()
  sudo.with do
    run usermod -aG kvm,libvirt $env["USER"]
    fs.set_metadata mode: 0o666 /dev/kvm
    run sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
    run sysctl -w kernel.unprivileged_userns_clone=1
    run systemctl stop apparmor.service
    run systemctl disable apparmor.service
    try
      # Reports an I/O error per profile it could not unload — around a hundred
      # of them — and then exits non-zero even though enforcement did get
      # turned off. The catch is for that false failure, not for a real one:
      # `aa-teardown` going missing must stay fatal, because passt segfaults if
      # AppArmor is still enforcing.
      run aa-teardown stderr: $NULLITER
    catch proc.Error: _
      nil

# Creates the CI VM and returns a handle to it.
def create_vm disk_size
  libvirt.create
    image: $VM_IMAGE
    os: :FREEBSD:
    dolang: (dolang_version())
    name: $VM_NAME
    app: $VM_APP
    memory: 12288
    vcpus: 4
    disk_size: $disk_size
    # The domain is destroyed with the runner at the end of the job, so there
    # is nothing to lose by dropping guest flushes — and a great deal of the
    # build's write traffic is temporaries that then never need to reach the
    # host's storage at all. Anything worth keeping is tarred out of the guest
    # while it is still running.
    cache: :UNSAFE:
    packages:
      - sqlite3
      - pkgconf
      - curl
      - llvm19
    init:
      add:
        target: /etc/rc.conf.d/firstboot_pkg_upgrade
        content: |
          firstboot_pkg_upgrade_enable="NO"
    # A top-level `add:` rather than an `init:` one: this runs once SSH is up,
    # so the user exists and the file is written through the guest's VFS with
    # the right ownership
    add:
      target: /home/ci/.profile
      content: $PROFILE
      chmod: 0o644

# Installs the Rust toolchain into the guest.
#
# Separate from `create_vm` so that a restored build cache can skip it: the
# cache carries `.rustup` and `.cargo`, which is a working toolchain already,
# and rustup's download is a large share of what provisioning costs.
#
# `http.get` runs on the runner and its chunks are piped into the guest's
# `sh`, so the download uses the runner's network rather than the domain's
# comparatively slow user-mode networking.
# `--no-modify-path` because `PROFILE` already puts the toolchain on `PATH`;
# letting rustup append its own line as well would leave two sources of truth
# for the same thing, only one of which survives into a cached run.
#
# `--profile minimal` drops rust-docs, clippy, and rustfmt — several hundred
# megabytes that this job does not use, off both the download and the cached
# `.rustup`. Re-enabling lint for this target would need `default` back.
def install_rust vm
  vm.with do
    http.get https://sh.rustup.rs do |resp|
      run sh -s -- -y --no-modify-path --profile minimal stdin: $resp.chunks()

# Uploads a snapshot of the workspace into the VM's home directory.
def upload_workspace vm
  run tar -czf /tmp/dolang-src.tar.gz --exclude=.git --exclude=target .
  vm.upload /tmp/dolang-src.tar.gz /home/ci/dolang-src.tar.gz
  vm.with do
    run tar -xzf dolang-src.tar.gz
    run rm -f dolang-src.tar.gz

# Prepares the runner to host VMs, creates the CI VM, and points the
# `dolang-ci` wrapper at it for the rest of the job.
#
# The VM is left running: GitHub runners are ephemeral, so it dies with the
# job.
def provision_vm w disk_size
  step $w 📦 "install virtualization packages" do install_virt()
  step $w 🔓 "unconfine user namespaces" do unconfine()
  step $w 🧹 "reclaim runner disk space" do
    sudo.with do fs.remove all: true ignore: true ...RUNNER_BALLAST

  let vm = create_vm $disk_size
  w.delta()

  step $w ⬆️ "upload workspace" do upload_workspace $vm
  step $w 📥 "restore build cache" do cache.restore $vm
  # A restored cache already supplies a toolchain, so this is usually a no-op
  step $w 🦀 "ensure rust" do
    if !cache.has_rust(vm)
      install_rust $vm
  export DOLANG_CI_VM $VM_NAME

# Packs the CI VM's build caches back onto the runner, for `actions/cache` to
# save once the job ends.
#
# Lives here rather than in `cache` so that the progress presentation stays
# with `PROGRESS_STYLE` and the runner-specific plumbing — `cache` is imported
# by this module, so it cannot import back. Without the `progress.with`, the
# indicators inside `cache.save` have no renderer configured and the step
# produces no output at all.
#
# Runs as its own workflow step rather than at the end of `setup`, because it
# has to happen after the build steps have populated the caches.
pub def save_cache()
  let name = env.get "DOLANG_CI_VM"
  if name
    let vm = libvirt.attach $name
    progress.with style: $PROGRESS_STYLE do
      progress.show icon: 💾 message: "save build cache" do |_|
        cache.save $vm
  nil

# Sets up the runner to build `target`, which defaults to whatever the runner
# builds natively.
#
# `shell` is the path to the workflow shell dispatcher that the `dolang-ci`
# wrapper runs. `rust` may be turned off for jobs that only need Do, and
# `disk_size` sizes the CI VM for targets that use one.
pub def setup
  :shell
  :target = nil
  :rust = true
  :disk_size = "50G"
do
  let vm = (target == VM_TARGET)
  # The wrapper and cargo configuration, plus VM provisioning or whatever a
  # host build needs
  let steps = (2 + (vm && 7 || rust && host_prereq_steps() || 0))

  progress.with style: $PROGRESS_STYLE do
    progress.show icon: 🚀 message: "set up runner" total: $steps do |w|
      step $w 🔧 "install dolang-ci wrapper" do install_wrapper $shell
      step $w 🦀 "configure cargo" do configure_cargo()

      if vm
        provision_vm $w $disk_size
      else if rust
        host_prereqs $w
