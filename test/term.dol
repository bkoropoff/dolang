import shell term strand progress
  fs:
    - with_temp_dir
  test:
    - assert
    - assert_eq
    - assert_throws
    - skip
    - test
  std:
    - TypeError
    - UnsupportedError
    - ValueError

let ESC = str b"\x1b"


#[test]
def console_geometry()
  # `term.console` is a name, so it pins to the host: `is_tty` is the
  # determinative "is there a real terminal" test.
  assert_eq (type term.console.can_style) $Bool
  assert_eq (type term.console.is_tty) $Bool

  # `geometry()` is only advisory, and never nil for the host console: each
  # dimension is independently nil when it cannot be determined, even when
  # `is_tty` is true, rather than the whole result being absent.
  let g = term.console.geometry()
  assert (type g term.Geometry)
  assert (g.rows == nil || type g.rows == Int)
  assert (g.cols == nil || type g.cols == Int)

#[test]
def text_string_coercion()
  let text = term.style("red", fg: :RED:, bold: true)
  assert_eq (type text) $term.Text
  assert_eq (str text) "$ESC[1;31mred$ESC[0m"
  assert_eq (str $ term.style :VALUE:) VALUE

  assert_eq (str $ term.style("indexed", fg: 123)) "$ESC[38;5;123mindexed$ESC[0m"
  assert_eq (str $ term.style("rgb", fg: [1, 2, 3])) "$ESC[38;2;1;2;3mrgb$ESC[0m"
  assert_eq (
    str $ term.style("rgb", bg: Tuple([4, 5, 6]))
  ) "$ESC[48;2;4;5;6mrgb$ESC[0m"

  assert_throws $ValueError do term.style fg: 256 text
  assert_throws $ValueError do term.style fg: [1, 2] text
  assert_throws $TypeError do term.style fg: [1, "x", 3] text

#[test]
def reusable_styles()
  let warning = term.style fg: :YELLOW: bold: true
  assert_eq (type warning) $term.Style
  assert_eq (str $ warning("Warning")) "$ESC[1;33mWarning$ESC[0m"

  let urgent = warning fg: :RED: underline: true
  assert_eq (type urgent) $term.Style
  assert_eq (str $ urgent("Failure")) "$ESC[1;4;31mFailure$ESC[0m"

  let ambient = urgent fg: :INHERIT: bold: :INHERIT:
  assert_eq (str $ ambient("Notice")) "$ESC[4mNotice$ESC[0m"

  let plain = ambient underline: :INHERIT:
  assert_eq (str $ plain("plain")) plain
  assert_eq (str $ term.style("text", fg: :INHERIT:)) text

  assert_throws $ValueError do warning bold: false

#[test]
def nested_styles()
  let inner = term.preformat("$ESC[31minner$ESC[0m after")
  let text = term.style("outer ", inner, " outer", bold: true)
  assert_eq (
    str text
  ) "$ESC[1mouter $ESC[31minner$ESC[0m$ESC[1m after outer$ESC[0m"

  assert_throws $ValueError do term.style bold: false text
  assert_throws $TypeError do term.style fg: RED text

#[test]
def preformatted_text()
  let text = term.preformat("$ESC[38;5;123mindexed$ESC[0m plain")
  assert_eq (type text) $term.Text
  assert_eq (str text) "$ESC[38;5;123mindexed$ESC[0m plain"

#[test]
def text_indent()
  let text = term.preformat("$ESC[31mred\nblue$ESC[0m\n")
  let indented = text.indent(2)
  assert_eq (type indented) $term.Text
  assert_eq (str indented) "  $ESC[31mred\n  blue$ESC[0m\n"
  assert_eq (text.indent(0)) $text

  let blank = term.preformat("a\n\nb").indent(2)
  assert_eq (str blank) "  a\n  \n  b"

  assert_throws $ValueError do text.indent(-1)
  assert_throws $TypeError do text.indent("2")

# --- Terminal output capture ----------------------------------------------

# Writes `source` into the temp dir and returns the script path, so tests can
# name it in a `run` invocation without the here string swallowing the
# arguments that follow it.
def script dir name source
  let path = (dir / name)
  path.write $source
  path

#[test]
def capture_collects_echo_lines()
  let out = []
  term.capture $out do
    echo hello world
    echo second
  assert_eq $out ["hello world\n", "second\n"]

#[test]
def sub_returns_captured_text()
  assert_eq (term.sub do echo("hi")) hi
  assert_eq (term.sub chomp: false do echo("hi")) "hi\n"

  # A CRLF written straight into the byte stream trims the same way.
  assert_eq (term.sub do term.output().write "hi\r\n") hi

#[test]
def print_stays_unterminated()
  # `sub` reports the byte stream verbatim, so the I/O mode must not reach it:
  # `echo` still terminates and `print` still does not, in either mode.
  def mixed()
    print a
    print b
    echo c

  assert_eq (term.sub mixed) abc

# Framing decides where the console's byte stream is cut into values and
# nothing else, so the same bytes come out either way.
#[test]
def capture_into_sink_frames_without_transforming()
  # `echo`'s terminator went into the byte stream, so it is part of the value.
  let lines = []
  term.capture $lines do echo hello
  assert_eq $lines ["hello\n"]

  # `chomp` is how a caller asks for it back off, and composes with the sink
  # the same way it would anywhere else.
  let chomped = []
  term.capture (chomped.sink().prechomp()) do echo hello
  assert_eq $chomped ["hello"]

  # Chunk framing cuts the stream elsewhere and reproduces it just the same.
  let chunks = []
  term.capture $chunks mode: :CHUNK: do echo hello
  let joined = ""
  for chunk = chunks
    joined = "$joined$(str(chunk))"
  assert_eq $joined "hello\n"

#[test]
def capture_flushes_partial_line()
  # An unterminated `print` is only visible once the scope ends and flushes,
  # and it has no terminator to carry.
  let out = []
  term.capture $out do print hi
  assert_eq $out ["hi"]

#[test]
def capture_is_unstyled_by_default()
  # A capture is not a terminal, so styling is off inside one — otherwise this
  # would pass piped and fail on a developer's terminal.
  assert_eq (term.sub do echo (term.style "warn" fg: :YELLOW:)) warn
  # And the console says so, which is what `echo` consulted to decide.
  let out = []
  term.capture $out do
    assert_eq (term.output().can_style) false

#[test]
def capture_can_style_opt_in()
  # Styling is a property of the installed console, so a test that is
  # specifically *about* styled output can ask for it — something a global tty
  # check could never express.
  let styled = "$ESC[33mwarn$ESC[0m"
  assert_eq (term.sub can_style: true do echo (term.style "warn" fg: :YELLOW:)) $styled

  # The same opt-in on the sink adapter, which is the route `capture` takes.
  let out = []
  term.capture (term.SinkConsole(out, can_style: true)) do
    assert_eq (term.output().can_style) true
    echo (term.style "warn" fg: :YELLOW:)
  assert_eq $out ["$styled\n"]

#[test]
def capture_reports_no_geometry()
  # A sink is never a terminal and has no layout, and the pin still answers
  # for the real terminal — unaffected by the capture in progress.
  let host = term.console.geometry()
  let out = []
  term.capture $out do
    assert_eq (term.output().is_tty) false
    assert_eq (term.output().geometry()) nil
    let pinned = term.console.geometry()
    assert_eq $pinned.rows $host.rows
    assert_eq $pinned.cols $host.cols

#[test]
def nesting_composes()
  let outer = []
  let inner = []
  term.capture $outer do
    echo o1
    term.capture $inner do echo i1
    echo o2

  assert_eq $outer ["o1\n", "o2\n"]
  assert_eq $inner ["i1\n"]

#[test]
def spawn_inherits_capture()
  let out = []
  term.capture $out do
    let s = strand.spawn do echo from-spawn
    s.join()
  assert_eq $out ["from-spawn\n"]

#[test]
def console_pins_past_capture()
  # `term.console` is a name, so it pins to the host for `write` and `put`
  # alike; only the anonymous `term.output()` follows the capture. Run in a
  # child so the pinned bytes land in a file rather than on the test runner's
  # terminal.
  with_temp_dir do |dir|
    let src = r|
      import term
      import shell
      import strand
      import fs
      let out = []
      term.capture $out do
        term.console.write "pinned-write\n"
        strand.pipeline output: $term.console
          do strand.from ["pinned-put"]
        echo captured
      fs.write $shell.args[0] (str out)

    let path = script $dir pin.dol $src
    let seen = (dir / "seen.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path $seen stderr: $err

    assert_eq $seen.read() r#"["captured\n"]"#
    # Both `write` and `put` are verbatim, so the only LF here is the one in
    # the source.
    assert_eq $err.read() "pinned-write\npinned-put"

#[test]
def concurrent_lines_do_not_interleave()
  # `echo` writes its payload and its terminator to the host console under one
  # lock. Two locks would let another strand slip a line in between, which
  # surfaces as run-together output — most visibly plain-mode progress lines.
  # Run in a child so the concurrent writes land in a file.
  with_temp_dir do |dir|
    let src = r|
      import strand:
        - fork
      fork
        do
          for _ = (0..200)
            echo aaaaaaaaaa
        do
          for _ = (0..200)
            echo bbbbbbbbbb

    let path = script $dir race.dol $src
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path stderr: $err

    let lines = Array(err.read().split("\n"))
    # `split` on a trailing terminator leaves one empty tail element.
    assert_eq $lines[lines.len - 1] ""
    let body = lines[..(lines.len - 1)]
    # A lost lock shows up as two payloads run together plus a blank line, so
    # both the count and the contents catch it.
    assert_eq $body.len 400
    for line = body
      assert ((line == "aaaaaaaaaa") || (line == "bbbbbbbbbb"))

#[test]
def child_stderr_is_captured()
  # An undirected child stderr is console-bound, so a capture takes it. Child
  # stdout is the data stream and still goes to the implicit sink.
  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stderr.write "child-err\n"
      shell.stdout.write "child-out\n"

    let path = script $dir noisy.dol $src
    let out = []
    let human = term.sub do run $shell.exe --no-cache $path stdout: $out

    assert_eq $human child-err
    assert_eq $out ["child-out\n"]

#[test]
def mute_silences_echo_and_child_stderr()
  # Same mechanism as `capture`, just wired to a sink that throws writes away
  # — so it composes with an enclosing capture rather than fighting it, and
  # a named `stdout:` is untouched.
  let out = []
  term.capture $out do
    term.mute do
      echo hidden
      print more
    echo visible
  assert_eq $out ["visible\n"]

  with_temp_dir do |dir|
    let src = r|
      import shell
      shell.stderr.write "should-not-appear\n"
      shell.stdout.write "child-out\n"

    let path = script $dir noisy.dol $src
    let child_out = []
    let human = term.sub do
      term.mute do run $shell.exe --no-cache $path stdout: $child_out

    assert_eq $human ""
    assert_eq $child_out ["child-out\n"]

#[test]
def mute_leaves_named_strand_output_alone()
  # Redirecting via `stdout: $out` pins the inner process's own implicit
  # output to `shell.stdout`, not `term.default` — `mute` only swaps that when
  # it is still the startup default, so an unnamed grandchild here still
  # reaches it. Only the console mechanism (`term.echo`) is silenced.
  with_temp_dir do |dir|
    let src = r|
      import term
      term.mute do
        strand.put visible
        echo hidden

    let path = script $dir quiet.dol $src
    let out = []
    run $shell.exe --no-cache $path stdout: $out
    assert_eq $out ["visible"]

#[test]
def progress_lines_are_captured()
  # Covers the other funnelled writer, `write_terminal_line`. Only plain-mode
  # progress goes through it — on a real terminal indicatif takes the terminal
  # over and draws directly, bypassing ordinary console output entirely.
  if term.console.is_tty
    skip "requires no terminal (progress draws directly on one)"

  let out = []
  term.capture $out do
    progress.show message: working do |_|
      nil
  assert (out.len > 0)

#[test]
def do_subclass_console()
  # The interface is a real type, so Do code can implement a console.
  class Recorder: term.Console
    pub field lines

    def (init) self
      term.Console.(init) $self
      self.lines = []

    pub def write self data
      self.lines.push (str data)
      data.len

    pub def flush _self
      nil

  let recorder = Recorder()
  term.capture $recorder do
    echo terminated
    print bare
  # `echo` assembles payload and terminator and issues one `write`, so the
  # subclass sees a single call with the line already terminated.
  assert_eq $recorder.lines ["terminated\n", "bare"]

  # Supplying only the two write members is enough: the capability members
  # have safe defaults, which the subclass inherits from the base. That
  # includes `line_ending`, which is what `echo` above terminated with.
  assert_eq $recorder.can_style false
  assert_eq $recorder.is_tty false
  assert_eq (recorder.geometry()) nil

#[test]
def do_console_declares_capabilities()
  # A Do field shadows the base's getter, and a Do method its `geometry()`.
  class MyGeometry: term.Geometry
    pub field rows
    pub field cols

    def (init) self rows cols
      term.Geometry.(init) $self
      self.rows = rows
      self.cols = cols

  class Fancy: term.Console
    pub field lines
    pub field can_style = true

    def (init) self
      term.Console.(init) $self
      self.lines = []

    pub def write self data
      self.lines.push (str data)
      data.len

    pub def flush _self
      nil

    pub def geometry _self
      MyGeometry 24 80

  let fancy = Fancy()
  term.capture $fancy do echo (term.style "warn" fg: :YELLOW:)
  assert_eq $fancy.lines ["$ESC[33mwarn$ESC[0m\n"]

  let g = fancy.geometry()
  assert (type g term.Geometry)
  assert_eq $g.rows 24
  assert_eq $g.cols 80

#[test]
def bare_geometry_refuses()
  # `term.Geometry` is the interface, so an instance of it has no dimensions to
  # report — the same refusal `term.Console`'s write methods make.
  let base = term.Geometry()
  assert (type base term.Geometry)
  assert_throws $UnsupportedError do base.rows
  assert_throws $UnsupportedError do base.cols

#[test]
def reentrant_console_does_not_recurse()
  # A console whose own `write` echoes falls through to the host rather than
  # routing back into itself until the call-depth limit. Run in a child so the
  # fallen-through line lands in a file — where it can be asserted on — rather
  # than on the test runner's terminal.
  with_temp_dir do |dir|
    let src = r|
      import term
      import shell
      import fs

      class Loud: term.Console
        pub field seen

        def (init) self
          term.Console.(init) $self
          self.seen = []

        pub def write self data
          self.seen.push (str data)
          echo "loud: $(str data)"
          data.len

        pub def flush _self
          nil

      let loud = Loud()
      let outer = []
      term.capture $outer do
        term.capture $loud do echo hello
      fs.write $shell.args[0] "$(str loud.seen) $(str outer)"

    let path = script $dir loud.dol $src
    let seen = (dir / "seen.txt")
    let err = (dir / "err.txt")
    run $shell.exe --no-cache $path $seen stderr: $err

    # The inner console saw the line, and the re-entrant `echo` skipped both
    # captures rather than landing in the enclosing one — which is what keeps
    # the guard simple.
    assert_eq $seen.read() r#"["hello\n"] []"#
    # It reached the host console, whose line ending is LF on every platform.
    # Two of them: the data the console was handed already carried `echo`'s
    # terminator, and the re-entrant `echo` adds its own.
    assert_eq $err.read() "loud: hello\n\n"
