import
  json:
    - encode
    - decode
  test:
    - assert
    - assert_eq
    - assert_throws
    - test
  std:
    - RuntimeError

#[test]
def parse_primitives()
  assert_eq (decode "null") nil
  assert_eq (decode "true") true
  assert_eq (decode "42") 42
  assert_eq (decode "3.14") 3.14
  assert_eq (decode "\"hello\"") "hello"

#[test]
def round_trip_primitives()
  assert_eq (decode $ encode nil) nil
  assert_eq (decode $ encode true) true
  assert_eq (decode $ encode 42) 42
  assert_eq (decode $ encode 3.14) 3.14
  assert_eq (decode $ encode "hello") "hello"

#[test]
def parse_arrays()
  assert_eq (decode "[]") []
  assert_eq (decode "[true, false, null]") [true, false, nil]
  assert_eq (decode "[1, [2, 3], 4]") [1, [2, 3], 4]

#[test]
def parse_objects()
  assert_eq (decode "{}") {}

  let nested = decode "{\"x\": {\"y\": {\"z\": 42}}}"
  assert_eq $nested["x"]["y"]["z"] 42

#[test]
def round_trip_objects()
  let orig = {"foo": 42, "bar": "hello", "baz": true}
  let serialized = encode $orig
  let deserialized = decode $serialized
  assert_eq $deserialized["foo"] 42
  assert_eq $deserialized["bar"] "hello"
  assert_eq $deserialized["baz"] true

#[test]
def round_trip_mixed()
  let complex = $
    users:
      - name: alice
        age: 30
      - name: bob
        age: 25
    total: 2

  let json_str = encode $complex
  let parsed = decode $json_str
  assert_eq $parsed["total"] 2
  let users = parsed["users"]
  assert_eq (type users) $Array

#[test]
def symbols_as_strings()
  let map_with_sym = {"key": :test:}
  let json_str = encode $map_with_sym
  let parsed = decode $json_str
  assert_eq $parsed["key"] "test"

#[test]
def numbers()
  assert_eq (decode "9223372036854775807") 9223372036854775807
  assert_eq (decode "-9223372036854775808") -9223372036854775808

  let err = assert_throws $RuntimeError do
    encode 170141183460469231731687303715884105727
  assert ((str err).contains "outside i64 range")
