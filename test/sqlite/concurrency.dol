import sqlite
  testlib.vfs:
    - vfs
  test:
    - assert
    - assert_eq
    - test
  fs:
    - Path
  strand:
    - fork

let STRAND_COUNT = 4
let INSERTS_PER_STRAND = 4
let WAL_STRAND_COUNT = 16
let WAL_INSERTS_PER_STRAND = 8

#[test]
#[vfs windows: false remote: false]
def concurrent_writers()
  let db = Path "test.db"
  sqlite.open $db do |conn|
    conn.execute t"CREATE TABLE test (id INTEGER PRIMARY KEY, value INTEGER)"

    fork
      for i = Range $STRAND_COUNT
        do sqlite.open $db retries: 20 min_wait: 2 do |writer|
          writer.prepare t"INSERT INTO test (value) VALUES (${#value})" do |stmt|
            for j = Range $INSERTS_PER_STRAND
              stmt.execute value: (i * INSERTS_PER_STRAND + j)

    conn.prepare t"SELECT value FROM test" do |stmt|
      let rows = [...stmt.query()]
      assert_eq $rows.len (STRAND_COUNT * INSERTS_PER_STRAND)

#[test]
#[vfs windows: false remote: false]
def wal()
  let retries = 30
  let min_wait = 2
  let db = Path "test.db"
  sqlite.open $db do |conn|
    conn.execute t"PRAGMA journal_mode=WAL"
    conn.execute t"CREATE TABLE test (id INTEGER PRIMARY KEY, value INTEGER)"

    fork
      for i = Range $WAL_STRAND_COUNT
        do sqlite.open $db :retries :min_wait do |writer|
          writer.prepare t"INSERT INTO test (value) VALUES (${#value})" do |stmt|
            for j = Range $WAL_INSERTS_PER_STRAND
              stmt.execute value: (i * WAL_INSERTS_PER_STRAND + j)
      - do sqlite.open $db :retries :min_wait do |reader|
          reader.prepare t"SELECT COUNT(*) AS cnt FROM test" do |stmt|
            for _ = Range 5
              let rows = [...stmt.query()]
              assert (rows[0]["cnt"] >= 0)

    let total = (WAL_STRAND_COUNT * WAL_INSERTS_PER_STRAND)

    conn.prepare t"SELECT COUNT(*) AS cnt FROM test" do |stmt|
      let rows = [...stmt.query()]
      assert_eq $rows[0]["cnt"] $total

    conn.execute t"PRAGMA wal_checkpoint(TRUNCATE)"

    conn.prepare t"SELECT COUNT(*) AS cnt FROM test" do |stmt|
      let rows = [...stmt.query()]
      assert_eq $rows[0]["cnt"] $total
