import security.nfs4: nfs4_security
  std:
    - FieldError
    - ImmutableError
    - TypeError
  test:
    - assert_eq
    - assert_throws
    - assert_type
    - test

#[test]
def constructs_nfs4_acls_on_every_platform()
  let rw = nfs4_security.Mask(:READ_DATA:, :WRITE_DATA:)
  let r = nfs4_security.Mask(:READ_DATA:)
  let inherit = nfs4_security.Flags(:FILE_INHERIT:, :DIRECTORY_INHERIT:)

  let owner = nfs4_security.Ace.owner type: :ALLOW: mask: $rw
  let group = nfs4_security.Ace.owning_group type: :ALLOW: mask: $r flags: $inherit
  let everyone = nfs4_security.Ace.everyone type: :DENY: mask: $r
  let named_user = nfs4_security.Ace.user 1234 type: :ALLOW: mask: $r
  let named_group = nfs4_security.Ace.group 5678 type: :AUDIT: mask: $r flags: $inherit

  assert_type $nfs4_security.Ace $owner
  assert_type $nfs4_security.Ace $group
  assert_type $nfs4_security.Ace $everyone
  assert_type $nfs4_security.Ace $named_user
  assert_type $nfs4_security.Ace $named_group

  assert_eq $owner.type :ALLOW:
  assert_eq $owner.principal :OWNER:
  assert_eq $owner.mask $rw
  assert_eq $owner.flags (nfs4_security.Flags())
  assert_throws $FieldError do owner.id

  assert_eq $group.principal :OWNING_GROUP:
  assert_eq $group.flags $inherit

  assert_eq $everyone.type :DENY:
  assert_eq $everyone.principal :EVERYONE:

  assert_eq $named_user.principal :USER:
  assert_eq $named_user.id 1234
  assert_throws $FieldError do everyone.id

  assert_eq $named_group.type :AUDIT:
  assert_eq $named_group.principal :GROUP:
  assert_eq $named_group.id 5678

  let acl = nfs4_security.Acl [owner, named_user, group, named_group, everyone]
  assert_type $nfs4_security.Acl $acl
  assert_eq $acl.aces.len 5
  assert_eq $acl.aces[0].principal :OWNER:
  assert_eq $acl.aces[1].id 1234
  assert_throws $ImmutableError do
    acl.aces[0] = nil

  # Unlike POSIX ACLs, NFSv4 ACLs have no required entries or completeness
  # invariant to validate: an empty ACL and a single-entry ACL both construct
  # without error.
  assert_eq $(nfs4_security.Acl []).aces.len 0

  assert_throws $TypeError do nfs4_security.Ace.user 1234 type: :ALLOW: mask: 5
  assert_throws $TypeError do nfs4_security.Acl [owner, 5]
