import
  std:
    - TypeError
  http
import test:
  - assert
  - assert_eq
  - test

def assert_err func type: ty :msg ...rest
  let res = try
    func ...rest
    false
  catch e
    assert (type e ty)
    assert_eq (str e) $msg
    true
  assert $res

#[test]
def get_rejects_non_url()
  assert_err $http.get 1 type: $TypeError msg: "type error: expected Url or str"
