import sys
  security.unix: unix_security
  uuid:
    - Guid
  sys:
    - NotFoundError
  std:
    - FieldError
    - ImmutableError
    - MissingKeyError
    - TypeError
    - UnexpectedKeyError
    - UnexpectedPosError
    - UnsupportedError
    - ValueError
    - Bin
    - Bool
    - hash
    - Int
    - Str
    - Tuple
  test:
    - assert_eq
    - assert_throws
    - assert_type
    - test
  security:
    - user_name
  security.unix:
    - Identity
    - Permission
    - user_id
    - group_name
    - group_id
    id: unix_info
    user_name: unix_user_name
  security.windows:
    - ace
    - acl
    - sec_desc
    - token_info
    - AccessMask
    - AceFlags
    - Ace
    - Acl
    - SecDesc
    - SecDescControl
    - SecInfo
    - Sid
    - SidName
    - TokenGroup
    - TokenGroupAttributes
    - TokenInfo

#[test]
def sid_converts_between_structural_forms()
  assert_eq [...TokenGroupAttributes()] []
  let sid = Sid S-1-5-32-544
  assert_type $Sid $sid
  assert_eq $sid.revision 1
  assert_eq $sid.identifier_authority :NT:
  assert_eq $sid.sub_authority_count 2
  assert_type $Tuple $sid.sub_authorities
  assert_eq $sid.sub_authorities[0] 32
  assert_eq $sid.sub_authorities[1] 544
  assert_eq (str sid) S-1-5-32-544
  let bytes = sid.to_bin()
  assert_type $Bin $bytes
  assert_eq (str(Sid(bytes))) S-1-5-32-544
  let unknown = Sid S-1-0x010203040506-7
  assert_eq $unknown.identifier_authority 1108152157446

  # A SID is its value, so two built by different routes compare equal, hash
  # alike, and index the same dict entry.
  assert_eq $sid (Sid(bytes))
  assert_eq (sid == unknown) false
  assert_eq (hash sid) (hash(Sid(bytes)))
  let seen = {}
  seen[sid] = "first"
  seen[Sid(bytes)] = "second"
  assert_eq $seen.len 1
  assert_eq $seen[Sid("S-1-5-32-544")] "second"

#[test]
def security_descriptor_converts_self_relative_packets()
  let packet = b"\x01\x5a\x15\xd0\x14\x00\x00\x00\x20\x00\x00\x00\x00\x00\x00\x00\x30\x00\x00\x00\x01\x01\x00\x00\x00\x00\x00\x05\x12\x00\x00\x00\x01\x02\x00\x00\x00\x00\x00\x05\x20\x00\x00\x00\x20\x02\x00\x00\x02\x00\x08\x00\x00\x00\x00\x00"
  let descriptor = SecDesc $packet
  assert_type $SecDesc $descriptor
  assert_eq $descriptor.revision 1
  assert_type $SecInfo $descriptor.mask
  assert_eq $descriptor.mask (SecInfo :ALL:)
  assert_type $SecDescControl $descriptor.control
  assert_eq $descriptor.control (SecDescControl :OWNER_DEFAULTED: :DACL_PRESENT: :SACL_PRESENT: :DACL_PROTECTED: :RM_CONTROL_VALID:)
  assert_eq $descriptor.rm_control_valid true
  assert_eq $descriptor.rm_control 90
  assert_eq (str descriptor.owner) S-1-5-18
  assert_eq (str descriptor.group) S-1-5-32-544
  assert_eq $descriptor.owner_defaulted true
  assert_eq $descriptor.group_defaulted false
  assert_eq $descriptor.dacl_present true
  assert_eq $descriptor.dacl_defaulted false
  assert_eq $descriptor.dacl_auto_inherit_required false
  assert_eq $descriptor.dacl_auto_inherited false
  assert_eq $descriptor.dacl_protected true
  assert_eq $descriptor.sacl_present true
  assert_eq $descriptor.sacl_defaulted false
  assert_eq $descriptor.sacl_auto_inherit_required false
  assert_eq $descriptor.sacl_auto_inherited false
  assert_eq $descriptor.sacl_protected false
  assert_eq $descriptor.to_bin() $packet

  let empty = SecDesc b"\x01\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  assert_throws $FieldError do empty.owner
  assert_throws $FieldError do empty.group
  assert_throws $FieldError do empty.rm_control

#[test]
def guid_converts_between_windows_structural_forms()
  let guid = Guid 00112233-4455-6677-8899-aabbccddeeff
  assert_type $Guid $guid
  assert_eq (str guid) 00112233-4455-6677-8899-aabbccddeeff
  assert_eq $guid (Guid "00112233-4455-6677-8899-AABBCCDDEEFF")
  assert_eq (hash guid) (hash(Guid(guid.bytes)))
  assert_eq $guid.bytes b"\x33\x22\x11\x00\x55\x44\x77\x66\x88\x99\xaa\xbb\xcc\xdd\xee\xff"

#[test]
def security_descriptor_exposes_acl_and_ace_views()
  let packet = b"\x01\x00\x04\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x14\x00\x00\x00\x02\x00\x58\x00\x03\x00\x00\x00\x00\x13\x1c\x00\x78\x56\x34\x12\x01\x02\x00\x00\x00\x00\x00\x05\x20\x00\x00\x00\x20\x02\x00\x00\xde\xad\xbe\xef\x0b\x00\x2c\x00\xef\xcd\xab\x90\x01\x00\x00\x00\x33\x22\x11\x00\x55\x44\x77\x66\x88\x99\xaa\xbb\xcc\xdd\xee\xff\x01\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x01\x02\x03\x04\x7f\xa0\x08\x00\x11\x22\x33\x44"
  let descriptor = SecDesc $packet
  let acl = descriptor.dacl
  assert_type $Acl $acl
  assert_eq $acl.revision :BASIC:
  assert_eq $acl.size 88
  assert_eq $acl.to_bin() $packet[20..]
  assert_eq $acl.aces.len 3
  assert_throws $ImmutableError do
    acl.aces[0] = nil

  let allowed = acl.aces[0]
  assert_type $Ace $allowed
  assert_eq $allowed.type :ACCESS_ALLOWED:
  assert_eq $allowed.type_code 0
  assert_type $AceFlags $allowed.flags
  assert_eq $allowed.flags.int 19
  assert_eq $allowed.flags (AceFlags :OBJECT_INHERIT: :CONTAINER_INHERIT: :INHERITED:)
  assert_eq $allowed.size 28
  assert_type $AccessMask $allowed.mask
  assert_eq $allowed.mask.int 305419896
  assert_eq (str allowed.sid) S-1-5-32-544
  assert_eq $allowed.object_inherit true
  assert_eq $allowed.container_inherit true
  assert_eq $allowed.inherited true
  assert_eq $allowed.application_data b"\xde\xad\xbe\xef"
  assert_throws $FieldError do allowed.object_type
  assert_throws $FieldError do allowed.successful_access

  let object = acl.aces[1]
  assert_eq $object.type :ACCESS_ALLOWED_CALLBACK_OBJECT:
  assert_eq $object.mask.int 2427178479
  assert_eq $object.object_flags 1
  assert_type $Guid $object.object_type
  assert_eq (str object.object_type) 00112233-4455-6677-8899-aabbccddeeff
  assert_eq $object.inherited_object_type nil
  assert_eq (str object.sid) S-1-1-0
  assert_eq $object.application_data b"\x01\x02\x03\x04"

  let unknown = acl.aces[2]
  assert_eq $unknown.type :UNKNOWN:
  assert_eq $unknown.type_code 127
  assert_eq $unknown.flags.int 160
  assert_eq $unknown.to_bin() b"\x7f\xa0\x08\x00\x11\x22\x33\x44"
  assert_throws $FieldError do unknown.mask
  assert_throws $FieldError do unknown.application_data

  assert_throws $FieldError do descriptor.sacl
  let null_dacl = SecDesc b"\x01\x00\x04\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  assert_eq $null_dacl.dacl nil
  let absent = SecDesc b"\x01\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  assert_throws $FieldError do absent.dacl

#[test]
def constructs_aces_and_acls()
  let sid = Sid S-1-1-0
  let guid = Guid 00112233-4455-6677-8899-aabbccddeeff
  let raw_mask = AccessMask.from_int 305419896
  let header_flags = AceFlags.from_int 3
  let mask_one = AccessMask.from_int 1
  let mask_two = AccessMask.from_int 2
  assert_eq $raw_mask.specific_rights 22136
  assert_type $AccessMask $raw_mask.standard_rights
  assert_type $AccessMask $raw_mask.generic_rights
  let allowed = Ace(allow: sid, mask: raw_mask, flags: header_flags, application_data: b"\x01\x02\x03")
  assert_type $Ace $allowed
  assert_eq $allowed.type :ACCESS_ALLOWED:
  assert_eq $allowed.flags.int 3
  assert_eq $allowed.mask $raw_mask
  assert_eq $allowed.application_data b"\x01\x02\x03\x00"

  let denied = Ace(deny: sid, mask: mask_one, object_type: guid, callback: true)
  assert_eq $denied.type :ACCESS_DENIED_CALLBACK_OBJECT:
  assert_eq $denied.object_flags 1
  assert_eq $denied.object_type $guid

  let audited = Ace(audit: sid, mask: mask_two, successful: true, failed: false)
  assert_eq $audited.type :SYSTEM_AUDIT:
  assert_eq $audited.successful_access true
  assert_eq $audited.failed_access false
  assert_throws $ValueError do
    Ace audit: $sid mask: $mask_two successful: false failed: false
  assert_throws $ValueError do
    Ace audit: $sid mask: $mask_two successful: true failed: false flags: (AceFlags.from_int 64)
  assert_throws $ValueError do Ace mask: $mask_one
  assert_throws $ValueError do Ace allow: $sid deny: $sid mask: $mask_one
  assert_throws $ValueError do Ace allow: $sid mask: $mask_one successful: true
  assert_throws $TypeError do Ace allow: :EVERYONE: mask: $mask_one
  assert_throws $TypeError do Ace allow: $sid mask: 1
  assert_throws $TypeError do Ace allow: $sid mask: $mask_one flags: :INHERIT_ONLY:
  assert_throws $TypeError do Ace deny: $sid mask: $mask_one object_type: 00112233-4455-6677-8899-aabbccddeeff

  let acl = Acl [allowed, denied, audited]
  assert_type $Acl $acl
  assert_eq $acl.revision :DIRECTORY_SERVICE:
  assert_eq $acl.aces.len 3
  assert_eq $acl.aces[0].to_bin() $allowed.to_bin()
  assert_eq $acl.aces[1].to_bin() $denied.to_bin()
  assert_eq $acl.aces[2].to_bin() $audited.to_bin()
  assert_throws $ValueError do Acl [denied] revision: :BASIC:

#[test]
def functionally_updates_security_descriptors()
  let empty = SecDesc b"\x01\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  let sid = Sid S-1-5-18
  let acl = Acl []
  let updated = empty.with
    owner: $sid
    dacl: $acl
    owner_defaulted: true
    dacl_protected: true
    rm_control: 90
  let constructed = SecDesc
    owner: $sid
    dacl: $acl
    owner_defaulted: true
    dacl_protected: true
    rm_control: 90
  assert_eq $constructed.to_bin() $updated.to_bin()
  assert_eq (str updated.owner) S-1-5-18
  assert_eq $updated.owner_defaulted true
  assert_eq $updated.dacl_present true
  assert_eq $updated.dacl_protected true
  assert_eq $updated.dacl.to_bin() $acl.to_bin()
  assert_eq $updated.rm_control 90
  assert_throws $FieldError do empty.owner

  let null = updated.with(dacl: nil, rm_control: nil)
  assert_eq $null.dacl nil
  assert_eq $null.rm_control_valid false
  let absent = null.with(dacl_present: false)
  assert_eq $absent.dacl_present false
  assert_throws $FieldError do absent.dacl
  assert_throws $ValueError do empty.with(dacl_present: true)
  assert_throws $ValueError do updated.with(dacl: acl, dacl_present: false)
  let loaded_absent = SecDesc(dacl_present: false)
  assert_eq $loaded_absent.dacl_present false
  assert_throws $ValueError do SecDesc(empty.to_bin(), dacl: acl)

#[test]
def coerces_well_known_sid_symbols()
  assert_eq (str(Sid(:BUILTIN_ADMINISTRATORS:))) S-1-5-32-544
  assert_eq (str(Sid(:LOCAL_SYSTEM:))) S-1-5-18
  assert_eq (str(Sid(:EVERYONE:))) S-1-1-0
  assert_eq (str(Sid(:MEDIUM_LABEL:))) S-1-16-8192
  assert_eq (str(Sid(:LOCAL_SERVICE:))) (str(Sid("S-1-5-19")))
  # Domain-relative SIDs need a lookup, so no symbol names one.
  assert_throws $ValueError do Sid :DOMAIN_ADMINS:

#[test]
def coerces_masks_and_ace_flags_from_symbols()
  let sid = Sid :LOCAL_SYSTEM:
  let generic_all = AccessMask :GENERIC_ALL:
  assert_eq (Ace(allow: sid, mask: generic_all).mask) $generic_all
  let several_mask = AccessMask :READ_CONTROL: :WRITE_DAC:
  let several = Ace allow: $sid mask: $several_mask
  assert_eq $several.mask $several_mask
  let inherit_flags = AceFlags :OBJECT_INHERIT: :CONTAINER_INHERIT:
  let inherited = Ace allow: $sid mask: $generic_all flags: $inherit_flags
  assert_type $AceFlags $inherited.flags
  assert_eq $inherited.container_inherit true
  assert_eq (Ace(allow: sid, mask: generic_all, flags: (AceFlags :INHERIT_ONLY:)).inherit_only) true

#[test]
def coerces_declarative_ace_specs()
  let entry = ace
    allow: :BUILTIN_ADMINISTRATORS:
    mask: :GENERIC_ALL:
  assert_type $Ace $entry
  assert_eq $entry.type :ACCESS_ALLOWED:
  assert_eq (str entry.sid) S-1-5-32-544
  assert_eq $entry.mask (AccessMask :GENERIC_ALL:)

  let denied = ace
    deny: S-1-5-18
    mask: :GENERIC_WRITE:
    flags: [:OBJECT_INHERIT:]
  assert_eq $denied.type :ACCESS_DENIED:
  assert_eq $denied.object_inherit true

  let audited = ace
    audit: :EVERYONE:
    mask: :GENERIC_READ:
    successful: true
  assert_eq $audited.type :SYSTEM_AUDIT:
  assert_eq $audited.successful_access true

  # Exactly one of allow/deny/audit, a mask, and nothing unrecognized.
  assert_throws $ValueError do ace allow: :EVERYONE: deny: :EVERYONE: mask: :GENERIC_ALL:
  assert_throws $ValueError do ace mask: :GENERIC_ALL:
  assert_throws $MissingKeyError do ace allow: :EVERYONE:
  assert_throws $UnexpectedKeyError do ace allow: :EVERYONE: mask: :GENERIC_ALL: masc: 1
  assert_throws $ValueError do ace audit: :EVERYONE: mask: :GENERIC_ALL:
  assert_throws $ValueError do ace allow: :EVERYONE: mask: :GENERIC_ALL: successful: true
  assert_throws $UnexpectedPosError do ace {allow: :EVERYONE:, mask: :GENERIC_ALL:}

#[test]
def coerces_declarative_acl_specs()
  let entries = acl
    - allow: :LOCAL_SYSTEM:
      mask: :GENERIC_ALL:
    - allow: :BUILTIN_ADMINISTRATORS:
      mask: :GENERIC_ALL:
  assert_type $Acl $entries
  assert_eq $entries.aces.len 2
  assert_eq $entries.revision :BASIC:
  assert_eq (str entries.aces[1].sid) S-1-5-32-544

  # Entries and named options share one call.
  let revised = acl
    revision: :DIRECTORY_SERVICE:
    - allow: :LOCAL_SYSTEM:
      mask: :GENERIC_ALL:
  assert_eq $revised.revision :DIRECTORY_SERVICE:
  assert_eq $revised.aces.len 1

  # Iterables can be spread, and an empty call is an empty ACL.
  assert_eq $(acl ...entries.aces).aces.len 2
  assert_eq $(acl()).aces.len 0
  assert_throws $ValueError do acl revison: :BASIC:

  # The rigid constructor keeps its strict signature.
  assert_throws $TypeError do Acl [{allow: :EVERYONE:, mask: :GENERIC_ALL:}]

#[test]
def coerces_declarative_security_descriptors()
  let descriptor = sec_desc
    owner: :BUILTIN_ADMINISTRATORS:
    dacl_protected: true
    dacl:
      for sid = [:LOCAL_SYSTEM:, :BUILTIN_ADMINISTRATORS:]
        - allow: $sid
          mask: :GENERIC_ALL:
  assert_type $SecDesc $descriptor
  assert_eq (str descriptor.owner) S-1-5-32-544
  assert_eq $descriptor.dacl_protected true
  assert_eq $descriptor.dacl.aces.len 2
  assert_eq (str descriptor.dacl.aces[0].sid) S-1-5-18

  # Options amend a descriptor given positionally.
  let amended = sec_desc $descriptor dacl_protected: false
  assert_eq $amended.dacl_protected false
  assert_eq (str amended.owner) S-1-5-32-544
  assert_eq (sec_desc(descriptor).to_bin()) $descriptor.to_bin()
  assert_eq (sec_desc(descriptor.to_bin()).to_bin()) $descriptor.to_bin()

  # Errors name where in the spec they happened.
  assert_throws $ValueError do sec_desc()
  assert_throws $ValueError do sec_desc {dacl_protectd: true}
  assert_throws $TypeError do
    sec_desc $
      dacl:
        - allow: :EVERYONE:
          mask: nope

  # The rigid constructor keeps its strict signature.
  assert_throws $TypeError do SecDesc dacl: [{allow: :EVERYONE:, mask: :GENERIC_ALL:}]

#[test]
def constructs_posix_acls_on_every_platform()
  let owner = unix_security.Ace.user_obj (Permission :READ: :WRITE:)
  let named = unix_security.Ace.user 1234 (Permission :READ:)
  let group = unix_security.Ace.group_obj (Permission :READ:)
  let mask = unix_security.Ace.mask (Permission :READ:)
  let other = unix_security.Ace.other()
  assert_type $unix_security.Ace $owner
  assert_type $unix_security.Ace $named
  assert_type $unix_security.Ace $group
  assert_type $unix_security.Ace $mask
  assert_type $unix_security.Ace $other
  let acl = unix_security.Acl [owner, named, group, mask, other]

  assert_type $unix_security.Acl $acl
  assert_eq $acl.aces.len 5
  assert_eq $acl.aces[0].type :USER_OBJ:
  assert_eq $acl.aces[0].permissions (Permission :READ: :WRITE:)
  assert_throws $FieldError do acl.aces[0].id
  assert_eq $acl.aces[1].type :USER:
  assert_eq $acl.aces[1].id 1234
  assert_throws $ImmutableError do
    acl.aces[0] = nil
  assert_throws $ValueError do unix_security.Acl []
  assert_throws $ValueError do unix_security.Acl [owner, named, group, other]

#[test]
def constructs_declarative_posix_aces_and_acls()
  let owner = unix_security.ace user_obj: [:READ:, :WRITE:]
  let named = unix_security.ace user: 1234 permissions: :READ:
  let group = unix_security.ace group_obj: :READ:
  let mask = unix_security.ace mask: [:READ:, :WRITE:]
  let other = unix_security.ace other: []
  let acl = unix_security.acl $owner $named {user: 2345, permissions: [:READ:]} $group $mask $other
  assert_type $unix_security.Acl $acl
  assert_eq $acl.aces.len 6
  assert_eq $acl.aces[2].id 2345
  assert_eq $acl.aces[2].permissions (Permission :READ:)
  assert_throws $ValueError do unix_security.ace user: 1 group: 2
  assert_throws $ValueError do unix_security.ace user_obj: :READ: permissions: :WRITE:
  assert_throws $ValueError do unix_security.acl()
  assert_throws $TypeError do unix_security.acl [owner, named, group, mask, other]
  assert_throws $TypeError do unix_security.Ace.user_obj :READ:
  assert_throws $UnexpectedPosError do unix_security.ace 1 user: 1
  assert_throws $UnexpectedKeyError do unix_security.ace bogus: 1

#[test]
def reports_security_information_for_target()
  if (sys.os_info().family == :UNIX:)
    let info = unix_info()
    assert_type $Identity $info
    assert_type $Int $info.uid
    assert_type $Int $info.gid
    assert_type $Int $info.euid
    assert_type $Int $info.egid
    assert_type $Tuple $info.groups
    for group = info.groups
      assert_type $Int $group
    let user = unix_user_name $info.euid
    let group = group_name $info.egid
    assert_type $Str $user
    assert_type $Str $group
    assert_eq (user_id user) $info.euid
    assert_eq (user_id(user_name())) $info.uid
    assert_eq (group_id group) $info.egid
    assert_throws $NotFoundError do user_id dolang-user-that-does-not-exist
    assert_throws $NotFoundError do group_id dolang-group-that-does-not-exist
    assert_throws $UnsupportedError do token_info()
    assert_throws $UnsupportedError do (Sid "S-1-5-32-544").lookup()
  else
    let info = token_info()
    assert_type $TokenInfo $info
    assert_type $Bool $info.is_elevated
    assert_type $Sid $info.user_sid
    assert_type $Sid $info.owner_sid
    assert_type $Sid $info.primary_group_sid
    let sid_name = info.user_sid.lookup()
    assert_type $SidName $sid_name
    assert_type $Sid $sid_name.sid
    assert_type $Str $sid_name.name
    assert_type $Str $sid_name.domain
    assert_type $Str $sid_name.qualified_name
    assert_eq (user_name()) $sid_name.name
    let by_sid = SidName.lookup $info.user_sid
    let by_name = SidName.lookup $sid_name.qualified_name
    let by_bin = SidName.lookup(info.user_sid.to_bin())
    assert_eq (str by_sid.sid) (str info.user_sid)
    assert_eq (str by_name.sid) (str info.user_sid)
    assert_eq (str by_bin.sid) (str info.user_sid)
    # A symbol names a well-known SID; a string is always an account name.
    let by_sym = SidName.lookup :BUILTIN_ADMINISTRATORS:
    assert_eq (str by_sym.sid) S-1-5-32-544
    assert_throws $ValueError do SidName.lookup :NOT_A_WELL_KNOWN_SID:
    # Resolving a well-known SID built from its symbol: what VM provisioning
    # does to find the local Administrators group.
    let admins = Sid(:BUILTIN_ADMINISTRATORS:).lookup()
    assert_type $SidName $admins
    assert_eq (str admins.sid) S-1-5-32-544
    assert_eq $admins.name $by_sym.name
    assert_eq $sid_name.kind :USER:
    assert_throws $NotFoundError do SidName.lookup dolang-account-that-does-not-exist
    assert_throws $UnsupportedError do unix_user_name 0
    let groups = info.groups
    assert_type $Int $groups.len
    assert_type $TokenGroup $groups[0]
    let snapshot = [...groups]
    assert_eq $snapshot.len $groups.len
    let first ...rest = groups
    assert_type $TokenGroup $first
    assert_eq (snapshot[1..].len) (Array(rest).len)
    assert_throws $ImmutableError do
      groups[0] = nil
    for group = groups
      assert_type $TokenGroup $group
      assert_type $Sid $group.sid
      assert_type $TokenGroupAttributes $group.attributes
      assert_type $Bool $group.mandatory
      assert_type $Bool $group.enabled_by_default
      assert_type $Bool $group.enabled
      assert_type $Bool $group.owner
      assert_type $Bool $group.use_for_deny_only
      assert_type $Bool $group.integrity
      assert_type $Bool $group.integrity_enabled
      assert_type $Bool $group.resource
      assert_type $Bool $group.logon_id
      if group.logon_id
        assert_eq (str group.sid) (str info.logon_sid)
    assert_throws $UnsupportedError do unix_info()
