import _vfs base64 digest json proc progress rand shell shlex ssh std sys time transfer xdg xml yaml
  fs:
    - Path
    - with_temp_dir
  std:
    - null
  url:
    - Url

let VM_NAMESPACE = "https://github.com/dolang-org/dolang"
let DEFAULT_CONNECT_URI = "qemu:///session"
let DEFAULT_MEMORY = 2048
let DEFAULT_VCPUS = 2
let DEFAULT_DISK_SIZE = "20G"

# Host cache modes for the domain disk, spelled as libvirt spells them.
let DISK_CACHE_MODES = Set $
  - none
  - writeback
  - writethrough
  - directsync
  - unsafe

# Disk I/O submission modes, likewise.
let DISK_IO_MODES = Set $
  - threads
  - native
  - io_uring

# `io_uring` is the best-performing submission mode and needs QEMU 6.0+ on a
# 5.1+ kernel, which any currently supported host satisfies. An older host
# fails at domain start rather than falling back, so `io:` can select a
# different mode.
let DEFAULT_DISK_IO = :IO_URING:
let PORT_START = 20000
let PORT_END = 60000
let PORT_ATTEMPTS = 10
let READY_SLEEP = 2.5
let STATE_SLEEP = 0.5
let READY_PATH = "/var/tmp/dolang-cloud-init-ready"
let PAYLOAD_PATH = "/var/tmp/dolang-payload.tar.gz"
let DOLANG_REPO = "dolang-org/dolang"

let DOLANG_PLATFORMS = Set $
  - x86_64-linux
  - x86_64-windows
  - aarch64-macos
  - x86_64-freebsd

let DOMAIN_STATES = $
  "running": :RUNNING:
  "idle": :IDLE:
  "paused": :PAUSED:
  "in shutdown": :IN_SHUTDOWN:
  "shutoff": :SHUTOFF:
  "crashed": :CRASHED:
  "pmsuspended": :PMSUSPENDED:
  "blocked": :BLOCKED:

# Raised when a requested libvirt domain does not exist.
pub class NoDomainError: std.RuntimeError
  pub field name = nil

  def (init) self name
    self.name = name

  pub def (str) self
    "libvirt domain does not exist: $(self.name)"

def cli program ...args
  env LC_ALL: C LANG: C do
    run $program ...args

def virsh connect_uri ...args
  cli virsh --quiet --connect $connect_uri ...args

def capture_virsh connect_uri stderr ...args
  sub do virsh $connect_uri ...args stderr: $stderr.prechomp()

def error_text lines
  "\n".join(lines).upper()

def missing_domain_error lines
  let text = error_text $lines
  (text.contains "DOMAIN NOT FOUND" ||
    text.contains "FAILED TO GET DOMAIN" ||
    text.contains "NO DOMAIN WITH MATCHING NAME")

def address_in_use_error lines
  let text = error_text $lines
  (text.contains "ADDRESS ALREADY IN USE" ||
    text.contains "FAILED TO BIND" && text.contains "PORT")

def require_name name
  name = str $name
  if (name == "" || name == "." || name == ".." ||
      name.contains("/") || name.contains("\\"))
    throw std.ValueError "invalid libvirt domain name: $name"
  name

def require_os os
  if (os == nil)
    throw std.ValueError "os: is required"
  os

# Defaults `arch` to the host's, and rejects any other.
#
# `DomainConfig.to_xml` emits `<domain type="kvm">` with a `host-passthrough`
# CPU, both of which require the guest architecture to match the host — a
# foreign one needs TCG emulation, plus a machine type and firmware chosen per
# target. Rejecting it here reports the unsupported argument instead of letting
# libvirt refuse the document with an error about KVM.
def require_arch arch
  let host = sys.cpu_info().arch
  let arch = (arch || host)
  if (arch != host)
    throw std.ValueError "arch: must be the host architecture $host, got $arch"
  arch

# Normalizes a disk `cache:`/`io:` option to its libvirt attribute spelling.
#
# The symbol vocabulary is libvirt's own value set, so lowercasing the name is
# the whole mapping (`:IO_URING:` becomes `io_uring`); a `Str` is accepted as
# written. Checking the value here reports a typo as a Do error naming the
# argument, instead of letting libvirt reject the whole document over one
# attribute.
def require_disk_mode value allowed name
  if (value == nil)
    return nil
  let text = str(value).lower()
  if !allowed.contains(text)
    throw std.ValueError "$name: unsupported value: $value"
  text

def normalized_app app
  let candidate = (app || shell.program || "dolang-libvirt")
  let value = if (type candidate Path)
    (candidate.stem || candidate.name)
  else
    str $candidate
  let value = value.replace("/", "_").replace("\\", "_")
  if (value == "" || value == "." || value == "..")
    throw std.ValueError "libvirt app name must not be empty"
  value

def data_root app
  let root = (xdg.data_home() / app / "libvirt")
  root.create_dir all: true
  root

def file_digest path
  let state = digest.Blake3()
  path.open rb do |file|
    for chunk = file
      state.update $chunk
  state.digest().hex()

def find_child node tag :namespace = nil
  for child = node.children
    if (type child xml.Node &&
        child.tag == tag &&
        child.namespace == namespace)
      return child
  nil

def require_child node tag :namespace = nil
  let child = find_child $node $tag :namespace
  if !child
    throw std.ValueError "missing XML element: $tag"
  child

def node_text node
  let text = ""
  for child = node.children
    if (type child Str)
      text = "$text$child"
  text

def metadata_value metadata name
  let node = find_child $metadata $name
  if node
    node_text $node
  else
    nil

def path_within path root
  while path
    if (path == root)
      return true
    path = path.parent
  false

def raw_undefine name connect_uri ...options
  try
    virsh $connect_uri undefine $name --nvram ...options
  catch proc.Error: _
    virsh $connect_uri undefine $name ...options

let CHUNK_SIZE = (512 * 1024)
let PARALLEL = 8

def copy_chunks total input output indicator
  strand.pipeline
    do strand.pool $PARALLEL (Range 0 total CHUNK_SIZE) do |offset|
      let chunk = input.read $CHUNK_SIZE :offset
      strand.put [offset, chunk]
    do strand.pool $PARALLEL $strand.input() do |item|
      let offset chunk = item
      output.write $chunk :offset
      indicator.delta $chunk.len

def payload_directory user
  "/home/$(user)/.dolang-libvirt-guest"

# How to reach a managed domain's guest over SSH.
#
# These are exactly the facts `create` records in the domain's `<dolang:vm>`
# metadata, so the metadata is this class's serialized form — see
# `guest_from_metadata`.
#
# Two transports use them. `exec` and `install_payload` drive the `ssh` and
# `scp` binaries directly, which is what bootstrap has to do: `dolang-vfs`
# does not exist in the guest until the payload is installed. Once it does,
# `with` runs blocks through the VFS instead.
class Guest
  # The forwarded SSH port. Public because `create` reassigns it while hunting
  # for a free one.
  pub field port = nil
  field user = nil
  field identity = nil
  field known_hosts = nil
  field command = nil

  def (init) self :port :user :identity :known_hosts :command
    self.port = int $port
    self.#user = str $user
    self.#identity = Path $identity
    self.#known_hosts = Path $known_hosts
    self.#command = str $command

  # The `ssh`/`scp` options every direct connection to the guest shares.
  #
  # Host key checking is `accept-new` rather than `no` so that a key change
  # after first contact is still an error.
  def options self :connect_timeout = nil
    let values = $
      - IdentitiesOnly=yes
      - BatchMode=yes
      - StrictHostKeyChecking=accept-new
      - "UserKnownHostsFile=$(self.#known_hosts)"
    if (connect_timeout != nil)
      values.push "ConnectTimeout=$connect_timeout"
    let flags = []
    for value = values
      flags.push -o $value
    flags

  # Runs `command` in the guest over `ssh`. Trailing keyword arguments are
  # passed through to `run`.
  def exec self command :connect_timeout = nil ...options
    let flags = self.#options connect_timeout: $connect_timeout
    run ssh -T -e none -a ...flags
      -l $self.#user -p $self.port -i $self.#identity
      -- 127.0.0.1 $command
      ...options

  # Polls `command` until it succeeds.
  def wait self command
    while true
      try
        self.#exec $command connect_timeout: 5
          stdout: $null
          stderr: $null
        return
      catch proc.Error: _
        time.sleep $READY_SLEEP

  # Waits until the guest accepts SSH connections.
  pub def wait_available self
    self.#wait "true"

  # Waits until cloud-init has finished provisioning the guest.
  pub def wait_ready self
    self.#wait "test -f $(shlex.quote READY_PATH)"

  # Copies one local file into the guest with `scp`.
  #
  # The bulk counterpart to `Domain.upload`: no VFS session, so no `chmod:` and
  # no progress reporting, but the transfer runs at the speed of the SSH
  # connection rather than of the VFS protocol. For anything large the
  # difference is the difference between seconds and tens of minutes.
  pub def send self source destination
    let flags = self.#options()
    run scp -q ...flags
      -P $self.port -i $self.#identity
      -- $source "$(self.#user)@127.0.0.1:$destination"
    nil

  # Copies one file out of the guest with `scp`. The counterpart to `send`.
  pub def fetch self source destination
    let flags = self.#options()
    run scp -q ...flags
      -P $self.port -i $self.#identity
      -- "$(self.#user)@127.0.0.1:$source" $destination
    nil

  # Copies `payload` into the guest and unpacks it.
  pub def install_payload self payload
    self.send $payload $PAYLOAD_PATH
    let dir = shlex.quote (payload_directory self.#user)
    let archive = shlex.quote $PAYLOAD_PATH
    self.#exec "mkdir -p $dir && tar -xzf $archive -C $dir && rm -f $archive"

  # Runs `block` through the guest's SSH VFS connection.
  pub def with self block ...options
    let reserved = Set $
      :user: :port: :identity: :known_hosts: :command:
      :host_key: :batch: :identities_only:
    for key _ = options
      if reserved.contains $key
        throw std.ValueError "Domain.with cannot override metadata option: $key"

    ssh.with 127.0.0.1 $block
      user: $self.#user
      port: $self.port
      identity: $self.#identity
      known_hosts: $self.#known_hosts
      command: [self.#command]
      host_key: :ACCEPT_NEW:
      batch: true
      identities_only: true
      ...options

  # The `<dolang:vm>` elements recording how to reach this guest — the form
  # `guest_from_metadata` reads back.
  pub def to_metadata self
    $
      - $ xml.Node ssh_port (str self.port)
      - $ xml.Node ssh_user $self.#user
      - $ xml.Node ssh_identity (str self.#identity)
      - $ xml.Node ssh_known_hosts (str self.#known_hosts)
      - $ xml.Node vfs_command $self.#command

# Reads a `Guest` out of a domain's `<dolang:vm>` metadata subtree, which is
# where `create` recorded it.
def guest_from_metadata metadata
  if !metadata
    throw std.ValueError "domain has no dolang:vm metadata"
  let port = metadata_value $metadata ssh_port
  let user = metadata_value $metadata ssh_user
  let identity = metadata_value $metadata ssh_identity
  let known_hosts = metadata_value $metadata ssh_known_hosts
  let command = metadata_value $metadata vfs_command
  if (port == nil || user == nil || identity == nil ||
      known_hosts == nil || command == nil)
    throw std.ValueError "domain has incomplete dolang:vm metadata"
  Guest :port :user :identity :known_hosts :command

# Everything that describes a domain to be created, with the libvirt XML
# document as its serialized form.
#
# Grouping these means `create` decides each one once and then hands over a
# single value, instead of threading a dozen positional arguments through to
# the emitter. It also makes the port-retry loop a mutate-and-re-emit rather
# than a re-derivation of the whole document.
class DomainConfig
  pub field name = nil
  # The `Guest` this domain will be reachable as, whose `port` `create`
  # reassigns between definition attempts.
  pub field guest = nil
  field arch = nil
  field memory = nil
  field vcpus = nil
  field overlay = nil
  field seed = nil
  field app = nil
  field workdir = nil
  field cache = nil
  field io = nil

  def (init)
    self
    :name
    :arch
    :guest
    :overlay
    :seed
    :app
    :workdir
    :memory = DEFAULT_MEMORY
    :vcpus = DEFAULT_VCPUS
    :cache = nil
    :io = DEFAULT_DISK_IO
  do
    self.name = require_name $name
    self.guest = guest
    self.#arch = arch
    self.#memory = int $memory
    self.#vcpus = int $vcpus
    self.#overlay = Path $overlay
    self.#seed = Path $seed
    self.#app = str $app
    self.#workdir = Path $workdir
    self.#cache = require_disk_mode $cache $DISK_CACHE_MODES cache
    self.#io = require_disk_mode $io $DISK_IO_MODES io

  # The libvirt domain document for this configuration.
  pub def to_xml self
    # Locally aliased so the tree below reads like the XML it emits.
    let Node = xml.Node

    # Only the overlay carries the tuning options: the seed is a read-only ISO
    # read once at boot, so its driver has nothing to gain from them.
    let overlay_driver = {name: "qemu", type: "qcow2"}
    if (self.#cache != nil)
      overlay_driver[:cache:] = self.#cache
    if (self.#io != nil)
      overlay_driver[:io:] = self.#io

    let vm = Node vm namespace: $VM_NAMESPACE prefix: dolang
      - $ Node managed "true"
      - $ Node app $self.#app
      - $ Node workdir (str self.#workdir)
    for element = self.guest.to_metadata()
      vm.push $element
    let metadata = Node metadata $vm

    Node domain attrs: {type: "kvm"}
      - $ Node name $self.name
      - $ Node memory (str self.#memory) attrs: {unit: "MiB"}
      - $ Node vcpu (str self.#vcpus)
      - $ Node os
          - $ Node type hvm attrs: {arch: str(self.#arch).lower()}
          - $ Node boot attrs: {dev: "hd"}
      - $ Node features
          - $ Node acpi
          - $ Node apic
      - $ Node cpu attrs: {mode: "host-passthrough"}
      - $ Node clock attrs: {offset: "utc"}
      - $ Node on_poweroff destroy
      - $ Node on_reboot restart
      - $ Node on_crash destroy
      - $ Node devices
          - $ Node disk attrs: {type: "file", device: "disk"}
              - $ Node driver attrs: $overlay_driver
              - $ Node source attrs: {file: str(self.#overlay)}
              - $ Node target attrs: {dev: "vda", bus: "virtio"}
          - $ Node disk attrs: {type: "file", device: "cdrom"}
              - $ Node driver attrs: {name: "qemu", type: "raw"}
              - $ Node source attrs: {file: str(self.#seed)}
              - $ Node target attrs: {dev: "sda", bus: "sata"}
              - $ Node readonly
          - $ Node interface attrs: {type: "user"}
              - $ Node backend attrs: {type: "passt"}
              - $ Node model attrs: {type: "virtio"}
              - $ Node portForward attrs: {proto: "tcp", address: "127.0.0.1"}
                  - $ Node range attrs: {start: str(self.guest.port), to: "22"}
          - $ Node serial attrs: {type: "pty"}
              - $ Node target attrs: {port: "0"}
          - $ Node console attrs: {type: "pty"}
              - $ Node target attrs: {type: "serial", port: "0"}
      $metadata

# A read-only view over a libvirt domain document.
#
# `virsh dumpxml` returns libvirt's own expansion of whatever was defined — a
# generated uuid, PCI addresses, filled-in defaults, rewritten devices — so
# this reads back only the parts we wrote and can still recognize. It is
# deliberately not the inverse of the document `create` emits: there is no
# faithful parse of an expanded document back into a configuration, so none is
# offered.
class DomainXml
  field document = nil

  def (init) self document
    self.#document = document

  # The `<name>` text, validated as a usable domain name.
  pub def name self
    if (self.#document.tag != "domain")
      throw std.ValueError "expected a libvirt <domain> document"
    let node = require_child $self.#document name
    let name = node_text(node).trim()
    require_name $name

  # The `<metadata>` element, or `nil`.
  pub def metadata self
    find_child $self.#document metadata

  # The `<dolang:vm>` subtree `create` writes, or `nil` for a domain this
  # module did not create.
  def vm self
    for node = self.#document.traverse()
      if (type node xml.Node &&
          node.tag == "vm" &&
          node.namespace == VM_NAMESPACE)
        return node
    nil

  # The guest's SSH connection facts. Throws if the domain is not one of ours
  # or its metadata is incomplete.
  pub def guest self
    guest_from_metadata $self.#vm()

  # The `<source file=...>` of the first disk with the given `device`.
  def disk_source self device
    let devices = find_child $self.#document devices
    if !devices
      return nil
    for disk = devices.children
      if (type disk xml.Node &&
          disk.tag == "disk" &&
          disk.attr("device") == device)
        let source = find_child $disk source
        if source
          return source.attr "file"
    nil

  # Every file-backed disk source, in document order.
  pub def disk_sources self
    let sources = []
    let devices = find_child $self.#document devices
    if !devices
      return sources
    for disk = devices.children
      if (type disk xml.Node &&
          disk.tag == "disk" &&
          disk.attr("device") == "disk")
        let source = find_child $disk source
        if source
          let path = source.attr "file"
          if (path != nil)
            sources.push $path
    sources

  # The work directory and overlay of a domain this module manages, or `nil`
  # if the domain is not ours or its recorded paths fail validation.
  #
  # Every condition here is a guard against removing something we did not
  # create: the domain must claim to be managed, its overlay must sit directly
  # in the recorded work directory, and that directory must live under the XDG
  # data home.
  pub def cleanup_info self
    let metadata = self.#vm()
    if !metadata
      return nil
    let workdir = metadata_value $metadata workdir
    let managed = metadata_value $metadata managed
    let source = self.#disk_source("disk")
    if (managed != "true" || workdir == nil || source == nil)
      return nil
    let workdir = Path(workdir).absolute()
    let source = Path(source).absolute()
    if (source.parent != workdir)
      return nil
    if !path_within(workdir, xdg.data_home().absolute())
      return nil
    record :workdir :source

# References a libvirt domain by name and connection URI.
#
# Domains returned by `create` carry connection metadata used by `with`.
pub class Domain
  pub field name = nil
  pub field connect_uri = nil

  def (init) self name connect_uri
    self.name = require_name $name
    self.connect_uri = str $connect_uri

  # Parses the domain's current libvirt XML.
  pub def dumpxml self
    let stderr = []
    let source = try
      capture_virsh $self.connect_uri $stderr dumpxml $self.name
    catch proc.Error: e
      if missing_domain_error $stderr
        throw NoDomainError $self.name
      echo $"\n".join(stderr)
      throw e
    xml.decode $source

  # A view over the domain's current libvirt XML.
  def xml self
    DomainXml $self.dumpxml()

  # Returns the domain XML's `<metadata>` subtree, or `nil`.
  pub def metadata self
    self.#xml().metadata()

  # Returns the normalized libvirt state as a symbol.
  pub def state self
    let stderr = []
    let value = try
      capture_virsh $self.connect_uri $stderr domstate $self.name
    catch proc.Error: e
      if missing_domain_error $stderr
        throw NoDomainError $self.name
      throw e
    let value = value.trim().lower()
    DOMAIN_STATES.get $value else: do
      sym $value.upper().replace(" ", "_").replace("-", "_")

  # Starts the domain.
  pub def start self
    virsh $self.connect_uri start $self.name
    nil

  # Force-stops the domain without undefining it.
  pub def destroy self
    virsh $self.connect_uri destroy $self.name
    nil

  # Requests a graceful shutdown and waits until the domain is shut off.
  pub def shutdown self
    progress.show message: "shut down $(self.name)" icon: ⏻ do |_|
      let state = self.state()
      if (state != :SHUTOFF:)
        if (state != :IN_SHUTDOWN:)
          if !(state == :RUNNING: || state == :BLOCKED: || state == :IDLE:)
            throw std.StateError "cannot gracefully shut down domain in state $state"
          virsh $self.connect_uri shutdown $self.name
        while (self.state() != :SHUTOFF:)
          time.sleep $STATE_SLEEP
    nil

  # Flattens the shut-off domain's file-backed disk into a standalone qcow2.
  pub def export_disk self destination :compress = false
    if (self.state() != :SHUTOFF:)
      throw std.StateError "domain must be shut off before exporting its disk"
    let document = self.#xml()
    let sources = document.disk_sources()
    if (sources.len != 1)
      throw std.ValueError "expected exactly one file-backed domain disk; found $(sources.len)"
    let source = Path(sources[0]).absolute()
    let destination = Path(destination).absolute()
    if (source == destination)
      throw std.ValueError "export destination is the domain disk"
    let cleanup = document.cleanup_info()
    if (cleanup && path_within(destination, cleanup.workdir))
      throw std.ValueError "export destination is inside the managed domain work directory"
    if destination.exists()
      throw std.ValueError "export destination already exists: $destination"
    let parent = (destination.parent || Path ".")
    parent.create_dir all: true
    progress.show message: "export disk" icon: 💿 do |_|
      with_temp_dir parent: $parent do |staging|
        let temporary = (staging / "disk.qcow2")
        if compress
          cli qemu-img convert -q -c -O qcow2 -- $source $temporary
        else
          cli qemu-img convert -q -O qcow2 -- $source $temporary
        if destination.exists()
          throw std.ValueError "export destination appeared during conversion: $destination"
        temporary.rename $destination
    destination

  # Copies one local file into the domain with `scp`.
  #
  # `upload` and `download` move their bytes through the VFS, which buys a
  # `chmod:` in the same session, byte-level progress, and any path the VFS can
  # reach — at a small fraction of the throughput the SSH connection itself
  # sustains. `send` and `fetch` trade all of that away for speed, and are what
  # a multi-hundred-megabyte transfer wants.
  pub def send self source destination
    self.#xml().guest().send $source $destination

  # Copies one file out of the domain with `scp`. The counterpart to `send`.
  pub def fetch self source destination
    self.#xml().guest().fetch $source $destination

  # Copies one local file into the domain. `chmod:` sets the destination's
  # mode within the same VFS session as the copy, if given.
  pub def upload self source destination :chmod = nil ...options
    let source = Path $source
    let destination = Path $destination
    source.open rb do |input|
      let total = input.metadata().size
      progress.show
        message: "upload $(source.name || source)"
        icon: ⬆️
        total: $total
        units: :BYTES:
        do |indicator|
          self.with ...options do
            destination.open wb do |output|
              copy_chunks $total $input $output $indicator
            if (chmod != nil)
              destination.set_metadata mode: $chmod

  # Copies one file from the domain to the local VFS.
  pub def download self source destination ...options
    let source = Path $source
    let destination = Path $destination
    destination.open wb do |output|
      self.with ...options do
        source.open rb do |input|
          let total = input.metadata().size
          progress.show
            message: "download $(source.name || source)"
            icon: ⬇️
            total: $total
            units: :BYTES:
            do |indicator| copy_chunks $total $input $output $indicator

  # Undefines the domain and removes a validated managed overlay.
  pub def undefine self
    let cleanup = self.#xml().cleanup_info()
    raw_undefine $self.name $self.connect_uri
    if cleanup
      cleanup.workdir.remove all: true ignore: true
    nil

  # Runs `block` through the domain's SSH VFS connection.
  pub def with self block ...options
    let guest = self.#xml().guest()
    if (self.state() != :RUNNING:)
      throw std.ValueError "libvirt domain is not running: $(self.name)"
    guest.with $block ...options

# Defines a domain from an XML string.
pub def define source :connect_uri = DEFAULT_CONNECT_URI
  let document = DomainXml (xml.decode source)
  let name = document.name()
  with_temp_dir do |dir|
    let path = (dir / "domain.xml")
    path.write $source
    virsh $connect_uri define $path
  Domain $name $connect_uri

# Attaches to an existing domain.
pub def attach name :connect_uri = DEFAULT_CONNECT_URI
  let domain = Domain $name $connect_uri
  domain.dumpxml()
  domain

# Lists every domain known to the connection.
pub def list :connect_uri = DEFAULT_CONNECT_URI
  let output = capture_virsh $connect_uri [] list --all --name
  let domains = []
  for name = output.split "\n"
    name = name.trim()
    if (name != "")
      domains.push (Domain name connect_uri)
  domains

def resolve_source source app digest_spec
  transfer.get $source app: $app digest: $digest_spec

let COMPRESSED_IMAGE_EXTS = Set ["gz", "xz", "zst"]

def prepared_image source root
  let ext = source.ext
  let compressed = (ext != nil && COMPRESSED_IMAGE_EXTS.contains(ext.lower()))
  let key = file_digest $source
  let entry = (root / "images" / key)
  entry.create_dir all: true
  let destination = (entry / "image")
  let lock_path = (entry / "lock")
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !destination.exists()
      with_temp_dir parent: $entry do |staging|
        let temporary = (staging / "image")
        if compressed
          transfer.unpack $source $temporary
        else
          source.copy $temporary
        temporary.rename $destination
  destination.absolute()

def image_format image
  let output = sub do cli qemu-img info --output json -- $image
  let format = json.decode(output).get "format"
  if (format == nil)
    throw std.ValueError "qemu-img did not report an image format"
  str $format

def ensure_key root app
  let directory = (root / "ssh")
  directory.create_dir all: true
  let key = (directory / "id_ed25519")
  let public = key.add_ext "pub"
  let lock_path = (directory / "lock")
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !(key.exists() && public.exists())
      key.remove ignore: true
      public.remove ignore: true
      cli ssh-keygen -q -t ed25519 -N "" -C $app -f $key
  record :key :public

def resolved_add_content spec app
  let source = spec.get :source:
  let content = spec.get :content:
  if ((source == nil) == (content == nil))
    throw std.ValueError "add: expected exactly one of source or content"
  if (content != nil)
    return content
  let resolved = resolve_source $source $app nil
  resolved.open rb do |file| file.read()

# `chmod:` accepts an `Int` mode or a `fs.unix.Mode`, normalized to a
# plain `Int` here, whichever `add:` it appears in.
#
# cloud-init's `write_files` wants `permissions` as an octal string, but that is
# its serialization detail, not a second calling convention: `parse_add_spec`
# renders the int with `Int.octal()` instead.
def require_chmod chmod
  _vfs.parse_mode $chmod

# Validates a top-level `add:` entry (`target`, `source:`|`content:`,
# `chmod:`, mirroring `dockman`'s own `add:` build step). No VFS access —
# just shape checking, so it's safe to call eagerly at parse time.
def validate_add_spec spec
  if !(type spec Dict)
    throw std.TypeError "add: expected Dict"
  let allowed = [:target:, :source:, :content:, :chmod:]
  for key _ = spec
    if !allowed.contains(key)
      throw std.UnexpectedKeyError $key

  let target = spec.get :target: else: do
    throw std.ValueError "add: missing target"
  if !(type target Str)
    throw std.TypeError "add target: expected Str"

  let source = spec.get :source:
  let content = spec.get :content:
  if ((source == nil) == (content == nil))
    throw std.ValueError "add: expected exactly one of source or content"
  if (content != nil && !(type content Str || type content Bin))
    throw std.TypeError "add content: expected Str or Bin"
  require_chmod (spec.get :chmod:)
  spec

# Performs a validated top-level `add:` entry against `domain`, on the host
# VFS: resolves `source:` (or stages `content:` into a host temp file), then
# `Domain.upload`s it — which itself opens the host source before entering
# the guest's VFS to write the destination.
def perform_add domain spec app
  let target = spec.get :target:
  let chmod = require_chmod (spec.get :chmod:)
  let source = spec.get :source:
  if (source != nil)
    let resolved = resolve_source $source $app nil
    domain.upload $resolved $target chmod: $chmod
  else
    with_temp_dir do |dir|
      let staged = (dir / "content")
      staged.write (spec.get :content:)
      domain.upload $staged $target chmod: $chmod

# Converts a dockman-style `add:` spec (`target`, `source`-or-`content`,
# `chmod`, plus cloud-init-specific `owner`/`append`/`defer`) into a
# cloud-init `write_files` entry.
def parse_add_spec spec app
  if !(type spec Dict)
    throw std.TypeError "add: expected Dict"
  let allowed = [:target:, :source:, :content:, :chmod:, :owner:, :append:, :defer:]
  for key _ = spec
    if !allowed.contains(key)
      throw std.UnexpectedKeyError $key

  let target = spec.get :target: else: do
    throw std.ValueError "add: missing target"
  if !(type target Str)
    throw std.TypeError "add target: expected Str"

  let content = resolved_add_content $spec $app
  let file = {path: target}
  if (type content Str)
    file[:content:] = content
  else if (type content Bin)
    file[:content:] = base64.encode $content
    file[:encoding:] = "b64"
  else
    throw std.TypeError "add content: expected Str or Bin"

  let chmod = require_chmod (spec.get :chmod:)
  if (chmod != nil)
    file[:permissions:] = chmod.octal()
  for key = [:owner:, :append:, :defer:]
    let value = spec.get $key
    if (value != nil)
      file[key] = value
  file

# Parses the `init:` sub-dict into boot-time cloud-init state. Like the
# top-level keyword arguments, `add:` and `run:` may repeat (dicts are
# multimaps). `run:` entries here must be a raw string or Array of strings —
# anything needing a live VFS connection belongs in the top-level repeated
# `run:` keyword argument instead.
def parse_init init app
  if (init == nil)
    return record boot: [] write: []
  if !(type init Dict)
    throw std.TypeError "init: expected Dict"

  let write = []
  let boot = []
  for key value = init
    if (key == :add:)
      write.push (parse_add_spec value app)
    else if (key == :run:)
      if (type value Str)
        boot.push [...(shlex.split value)]
      else if (type value Array)
        boot.push [...value]
      else
        throw std.TypeError "init.run: expected Str or Array"
    else if (type key Int)
      throw std.UnexpectedPosError $key
    else
      throw std.UnexpectedKeyError $key

  record :boot :write

# Parses the top-level repeated `add:`/`run:` keyword arguments, both run
# post-SSH. `run:` only accepts `func` values here — boot-time commands
# belong in `init: {run: ...}`.
def parse_post_options options
  let post = []
  for key value = options
    if (key == :add:)
      post.push (record kind: :add: spec: (validate_add_spec value))
    else if (key == :run:)
      if (type value Str || type value Array)
        throw std.TypeError "run: expected a func; use init: {run: ...} for boot-time commands"
      post.push (record kind: :run: block: value)
    else if (type key Int)
      throw std.UnexpectedPosError $key
    else
      throw std.UnexpectedKeyError $key
  post

def cloud_config user public_key packages boot write_files
  let run = ["set -e"]
  for entry = boot
    run.push (shlex.join entry)
  run.push "touch $(shlex.quote READY_PATH)"

  let user_config = $
    name: $user
    groups:
      - wheel
    shell: /bin/sh
    ssh_authorized_keys:
      - $public_key
  if packages.contains "sudo"
    user_config[:sudo:] = "ALL=(ALL) NOPASSWD:ALL"

  let config = $
    hostname: dolang-ci
    manage_etc_hosts: true
    ssh_pwauth: false
    users:
      - $user_config
    runcmd: $run
    if (packages.len > 0)
      package_update: false
      package_upgrade: false
      :packages
    if (write_files.len > 0)
      :write_files
  "#cloud-config\n$(yaml.encode config)"

# Builds the cloud-init seed ISO, cached under a digest of its contents so
# identical configurations share one.
def build_seed root user_data
  let key = digest.blake3(user_data).hex()
  let entry = (root / "seeds" / key)
  entry.create_dir all: true
  let destination = (entry / "seed.iso")
  let lock_path = destination.add_ext lock
  lock_path.open a+ do |lock| lock.lock (..) do |_|
    if !destination.exists()
      with_temp_dir parent: $destination.parent do |dir|
        let user_data_path = (dir / "user-data")
        let metadata_path = (dir / "meta-data")
        let temporary = (dir / "seed.iso")
        user_data_path.write $user_data
        metadata_path.write $ yaml.encode $
          "instance-id": "dolang-$key"
          "local-hostname": dolang-ci
        cli cloud-localds $temporary $user_data_path $metadata_path
        temporary.rename $destination
  destination.absolute()

# Normalizes `dolang:` into `nil` (skip) or `{version:|archive:, digest:?}`.
def normalize_dolang_spec spec
  if (spec == false)
    return nil
  if (spec == true)
    return {}
  if (type spec Dict)
    let allowed = [:version:, :archive:, :digest:]
    for key _ = spec
      if !allowed.contains(key)
        throw std.UnexpectedKeyError $key
    if ((spec.get(:version:) == nil) == (spec.get(:archive:) == nil))
      throw std.ValueError "dolang: expected exactly one of version or archive"
    if (spec.get(:digest:) != nil && spec.get(:version:) != nil)
      throw std.ValueError "dolang: digest is not yet supported together with version"
    return spec
  if (type spec Path)
    return {archive: spec}
  if (type spec Url)
    return {archive: spec}
  if (type spec Str)
    return {version: spec}
  throw std.TypeError "dolang: expected Bool, Str, Path, Url, or Dict"

def dolang_platform_key os arch
  "$(str(arch).lower())-$(str(os).lower())"

def dolang_artifact_name os arch
  let key = (dolang_platform_key os arch)
  (DOLANG_PLATFORMS.contains(key) && "dolang-$key.tar.gz" || nil)

def dolang_current_tag()
  let major minor patch = shell.VERSION
  "v$major.$minor.$patch"

# GitHub serves public release assets at a predictable, unauthenticated URL,
# so fetching one is just another `transfer.get`-cached download — no `gh`
# CLI (and no token) required.
def dolang_release_url tag artifact
  "https://github.com/$DOLANG_REPO/releases/download/$tag/$artifact"

# Resolves `dolang:` to a local archive path (cached via `transfer`), or
# `nil` if Do should not be installed into the guest. When `dolang:` is left
# at its implicit `true` default, a missing release/artifact is treated as
# "not available for this platform" rather than an error.
def resolve_dolang spec os arch app
  spec = normalize_dolang_spec $spec
  if (spec == nil)
    return nil

  let archive = spec.get :archive:
  if (archive != nil)
    return resolve_source $archive $app (spec.get :digest:)

  let explicit = (spec.get(:version:) != nil)
  let tag = if explicit
    spec.get(:version:)
  else
    dolang_current_tag()
  let artifact = dolang_artifact_name $os $arch
  if (artifact == nil)
    if explicit
      throw std.ValueError "dolang: no known release artifact for $(dolang_platform_key os arch)"
    return nil

  let url = dolang_release_url $tag $artifact
  try
    resolve_source (Url url) $app nil
  catch std.Error: e
    if explicit
      throw e
    nil

def raw_define document connect_uri workdir
  let source = xml.encode $document
  let path = (workdir / "domain.xml")
  path.write $source
  virsh $connect_uri define $path

def remove_partial name connect_uri workdir
  try
    let domain = Domain $name $connect_uri
    if (domain.state() != :SHUTOFF:)
      virsh $connect_uri destroy $name
        stdout: $null
        stderr: $null
  catch _
    nil
  try
    raw_undefine $name $connect_uri
      stdout: $null
      stderr: $null
  catch _
    nil
  workdir.remove all: true ignore: true

# Creates and starts a cloud-init domain.
#
# # Parameters
#
# | Name            | type                 | Description |
# | --------------- | -------------------- | ------------------------------------------------------ |
# | `image`         | `Str`\|`Path`\|`Url` | Base disk image (may be `.gz`/`.xz`/`.zstd` compressed) |
# | `name`          | `Str`                | Domain name; auto-generated if omitted |
# | `os`            | `Sym`                | Guest OS, using `sys`'s symbol vocabulary            |
# | `arch`?         | `Sym`                | Guest CPU architecture, `sys` symbol; must be the host's, which is the default |
# | `app`?          | `Str`                | Cache/data namespace; derived from `shell.program` by default |
# | `user`?         | `Str`                | Guest user to create (default `"ci"`) |
# | `dolang`?       | See below            | Installs Do into the guest — see [`dolang:`](#dolang) |
# | `image_digest`? | `Str`                | `algorithm:hex` digest to verify a downloaded `image` |
# | `packages`?     | `Array`              | Guest packages to install |
# | `memory`?       | `Int`                | Guest memory in MiB (default `2048`) |
# | `vcpus`?        | `Int`                | Guest vCPU count (default `2`) |
# | `disk_size`?    | `Str`                | Disk size (default `"20G"`)               |
# | `cache`?        | `Sym`                | Disk host cache mode — see [`cache:`](#cache) |
# | `io`?           | `Sym`                | Disk I/O submission mode — see [`io:`](#io) |
# | `connect_uri`?  | `Str`                | libvirt connection URI (default `"qemu:///session"`) |
# | `init`?         | `Dict`               | Early boot provisioning — see [`init:`](#init) |
# | `add`*          | `Dict`               | Uploads a file — see [`add:`](#add)         |
# | `run`*          | `func`               | Runs a block in VFS context |
#
# # `dolang:`
#
# | Value                            | Behavior |
# | -------------------------------- | ------------------------------- |
# | `false`                          | Skip installation.               |
# | `true` (default)                 | Install matching release for target platform if available. |
# | a version tag, e.g. `"v0.1.1"`   | Install specific release version |
# | a `Path` or `Url`                | Install provided release archive |
# | a `Dict`                         | Explicit form of the above — see below. |
#
# `dolang:`'s dict form:
#
# | Key       | type          | Description                          |
# | --------- | --------------| -------------------------------------|
# | `version`? | `Str`         | Version tag; excludes `archive`     |
# | `archive`? | `Path`\|`Url` | Release archive; excludes `version` |
# | `digest`?  | `Str`        | `algorithm:hex` digest for `archive` |
#
# # `cache:`
#
# Host cache mode for the domain disk. Defaults to the hypervisor's own
# default, which honors guest flushes.
#
# | Value            | Behavior |
# | ---------------- | -------- |
# | `:NONE:`         | `O_DIRECT`; no host page cache, guest flushes honored |
# | `:WRITEBACK:`    | Host page cache, guest flushes honored |
# | `:WRITETHROUGH:` | Host page cache, every write flushed |
# | `:DIRECTSYNC:`   | `O_DIRECT` and every write flushed |
# | `:UNSAFE:`       | Host page cache, guest flushes **ignored** |
#
# `:UNSAFE:` loses the disk's contents if the host or the domain dies
# uncleanly, since nothing the guest wrote is guaranteed to have reached
# storage until the domain shuts down. That is a fair trade for a disposable
# build domain — dropping flushes removes them from the critical path, and
# files written and deleted within one run need never reach storage at all —
# but it is not a safe default for a domain whose disk matters.
#
# # `io:`
#
# Disk I/O submission mode, defaulting to `:IO_URING:`.
#
# | Value        | Behavior |
# | ------------ | -------- |
# | `:IO_URING:` | `io_uring`; needs QEMU 6.0+ on a 5.1+ kernel |
# | `:THREADS:`  | Thread pool |
# | `:NATIVE:`   | Linux AIO; only asynchronous with `cache:` `:NONE:` or `:DIRECTSYNC:` |
#
# An older host fails at domain start rather than falling back, so select
# `:THREADS:` there.
#
# `:NATIVE:` needs `O_DIRECT` to be asynchronous; paired with a cache mode
# that uses the host page cache it quietly degrades to blocking submission.
# `:IO_URING:` has no such pairing constraint.
#
# # `init:`
#
# | Key    | type            | Description                                          |
# | ------ | --------------- | ---------------------------------------------------  |
# | `add`* | `Dict`          | Writes a file during early boot                      |
# | `run`* | `Str`\|`Array`  | Split with `shlex` if a `Str`. Run during early boot |
#
# # `add:`
#
# | Key        | type                 | Description                            |
# | ---------- | -------------------- | ------------------------------------- |
# | `target`   | `Str`                | Guest file path to write              |
# | `source`?  | `Str`\|`Path`\|`Url` | Resolved and read; excludes `content` |
# | `content`? | `Str`\|`Bin`         | Embedded directly; excludes `source` |
# | `chmod`?   | `Int`                | File mode, e.g. `0o644`               |
#
# # Returns
#
# `Domain`
#
# # Errors
#
# | Error          | Condition                                                            |
# | -------------- | ----------------------------------------------------------------------- |
# | `ValueError`   | `image` or `os` is omitted, `arch` is not the host's, or a domain named `name` already exists |
# | `RuntimeError` | No forwarded SSH port could be allocated                                |
# | `TypeError`    | Invalid argument type |
#
# # Example
#
# ```
# let domain = libvirt.create
#   image: freebsd.qcow2.xz
#   os: :FREEBSD:
#   name: freebsd-build
#   packages:
#     - sqlite3
#   init:
#     add:
#       target: /etc/example.conf
#       content: |
#         enabled=yes
#   run: do
#     run uname -a
#
# echo $domain.name
# ```
pub def create
  :image = nil
  :name = nil
  :os = nil
  :arch = nil
  :app = nil
  :user = "ci"
  :dolang = true
  :image_digest = nil
  :packages = []
  :memory = DEFAULT_MEMORY
  :vcpus = DEFAULT_VCPUS
  :disk_size = DEFAULT_DISK_SIZE
  :cache = nil
  :io = DEFAULT_DISK_IO
  :connect_uri = DEFAULT_CONNECT_URI
  :init = nil
  ...options
do
  if (image == nil)
    throw std.ValueError "image: is required"
  os = require_os $os
  arch = require_arch $arch
  app = normalized_app $app
  let post = parse_post_options $options
  name = require_name(name || "$app-$(rand.string 8)")
  user = require_name $user
  let root = data_root $app
  let staged = parse_init $init $app
  let workdir = (root / "domains" / name).absolute()
  try
    attach $name :connect_uri
    throw std.ValueError "libvirt domain already exists: $name"
  catch NoDomainError: _
    nil
  workdir.remove all: true ignore: true
  workdir.create_dir all: true

  progress.show message: "create $name" icon: 🖥️ do |_|
    let succeeded = false
    try
      let image = progress.show message: "resolve image" do |_|
        resolve_source $image $app $image_digest
      let prepared = progress.show message: "prepare image" icon: 💿 do |_|
        let stored = prepared_image $image $root
        record image: $stored format: $(image_format stored)
      let payload = progress.show message: "resolve dolang" do |_|
        resolve_dolang $dolang $os $arch $app
      let setup = progress.show message: "prepare cloud-init" icon: ☁️ do |_|
        let keys = ensure_key $root $app
        let public_key = keys.public.read().trim()
        let user_data = cloud_config $user $public_key $packages $staged.boot $staged.write
        let seed = build_seed $root $user_data
        record :keys :seed

      let overlay = progress.show message: "create disk" icon: 💾 do |_|
        let overlay = (workdir / "disk.qcow2").absolute()
        cli qemu-img create -q -f qcow2 -F $prepared.format -b $prepared.image $overlay $disk_size
        overlay
      let known_hosts = (workdir / "known_hosts").absolute()
      let command = if payload
        "$(payload_directory user)/dolang-vfs"
      else
        "dolang-vfs"

      let config = DomainConfig
        :name :arch :app :workdir :memory :vcpus :cache :io
        overlay: $overlay
        seed: $setup.seed
        guest: $ Guest
          port: (rand.int PORT_START PORT_END)
          user: $user
          identity: $setup.keys.key.absolute()
          known_hosts: $known_hosts
          command: $command

      let domain = progress.show message: "start domain" do |_|
        let domain = Domain $name $connect_uri
        let started = false
        for attempt = 0..PORT_ATTEMPTS
          # A forwarded port is only known to be free once libvirt has bound
          # it, so a collision means re-emitting with a fresh one.
          if (attempt > 0)
            config.guest.port = rand.int $PORT_START $PORT_END
          let document = config.to_xml()
          raw_define $document $connect_uri $workdir
          let stderr = []
          try
            virsh $connect_uri start $name stderr: $stderr.prechomp()
            started = true
          catch proc.Error: e
            try
              raw_undefine $name $connect_uri
            catch _
              nil
            if (!address_in_use_error(stderr) || attempt == PORT_ATTEMPTS - 1)
              echo $"\n".join(stderr)
              throw e
          if started
            break
        if !started
          throw std.RuntimeError "could not allocate a forwarded SSH port"
        domain

      # Read the guest back out of the defined domain rather than reusing the
      # local one: if libvirt failed to record the `<dolang:vm>` metadata, that
      # surfaces here instead of at the first `with`.
      let dumped = domain.dumpxml()
      let guest = DomainXml(dumped).guest()
      progress.show message: "wait for SSH" icon: 🔑 do |_|
        guest.wait_available()
      if payload
        progress.show message: "copy payload" icon: 📦 do |_|
          guest.install_payload $payload
      progress.show message: "wait for provisioning" do |_|
        guest.wait_ready()
      for action = post
        if (action.kind == :add:)
          perform_add $domain $action.spec $app
        else
          domain.with do
            action.block()
      succeeded = true
      domain
    finally
      if !succeeded
        progress.show message: "clean up" icon: 🧹 do |_|
          remove_partial $name $connect_uri $workdir

# Creates a domain, runs `block` through its VFS, and tears it down — even
# if `block` throws.
#
# # Parameters
#
# Takes the same keyword arguments as `create`, plus:
#
# | Name    | type     | Description             |
# | ------- | -------- | ------------------------ |
# | `block` | `func`  | Block to run in the VFS |
#
# # Returns
#
# The result of `block`.
#
# # Example
#
# ```
# libvirt.with
#   image: freebsd.qcow2.xz
#   os: :FREEBSD:
#   do
#     run uname -a
# ```
pub def with
  block
  :image = nil
  :name = nil
  :os = nil
  :arch = nil
  :app = nil
  :user = "ci"
  :dolang = true
  :image_digest = nil
  :packages = []
  :memory = DEFAULT_MEMORY
  :vcpus = DEFAULT_VCPUS
  :disk_size = DEFAULT_DISK_SIZE
  :cache = nil
  :io = DEFAULT_DISK_IO
  :connect_uri = DEFAULT_CONNECT_URI
  :init = nil
  ...options
do
  let domain = create
    :image :name :os :arch :app :user :dolang :image_digest :packages
    :memory :vcpus :disk_size :cache :io :connect_uri :init ...options
  try
    domain.with $block
  finally
    if (domain.state() != :SHUTOFF:)
      domain.destroy()
    domain.undefine()
