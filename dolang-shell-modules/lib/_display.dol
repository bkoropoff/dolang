# Shared rendering for the YAML-shaped dumps the shell's inspection
# entrypoints print.
#
# A dump is an ordinary value, built whole and then emitted rather than printed
# as it is discovered: a section that turns out to have no content can be
# dropped entirely, and a block can align its keys against the widest one it
# holds.
#
# The shape of the value is the shape of the output. A dict is a block of
# `key: value` lines, an array or tuple a block of `- item` lines, and anything
# else is one line, so most of a dump is written as vertical layout. A value
# that needs presenting some other way than its own string conversion is
# rendered ahead of time into a `term.Text` -- by one of the leaves here, or by
# the caller -- and the renderer prints that as the finished line it is.

import std sys term
import security.unix

# A dump reads as the spec that would recreate what it describes, so it is
# colored as that source would be: the shell's own syntax highlighting, with
# keys and structural punctuation yellow, string literals green, numbers cyan,
# constants magenta, and the parenthetical asides dim as comments are.
#
# A value with no counterpart in source -- a timestamp, a UUID, a path, or a
# description this module wrote itself -- is left uncolored rather than being
# passed off as the string its rendering happens to be.
#
# The section heading has no counterpart in source, and answers to nothing.
let section_style = term.Style fg: :BRIGHT_BLUE: bold: true
let key_style = term.Style fg: :YELLOW:
let delim_style = term.Style fg: :YELLOW:
let literal_style = term.Style fg: :GREEN:
let number_style = term.Style fg: :CYAN:
let constant_style = term.Style fg: :MAGENTA:
let note_style = term.Style fg: :WHITE: dim: true
let absent_style = term.Style dim: true

def spaces n
  " ".repeat(n)

def bullet indent
  delim_style "$(spaces indent)- "

let SIZE_UNITS = ["KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
# A unit only takes over from the one below it once the count is half again
# larger than the unit itself: switching exactly at 1024 would render 1025
# bytes as `1.00 KiB`, which says less than the number it replaced.
let SIZE_STEP = 1536.0

# --- Renderer ---------------------------------------------------------------

# True when `value` is a sequence of items rather than a keyed block. A tuple
# is one as much as an array is: an object that reports a fixed-shape field as
# a tuple is reporting a sequence, not a value that prints on one line.
def is_sequence value
  (type value Array || type value Tuple)

# True when `value` opens a block beneath the line that introduces it. An empty
# block has nothing to open, so it reads as `{}` or `[]` in place.
def is_block value
  ((type value Dict || is_sequence value) && value.len > 0)

# Renders a value that occupies a single line, colored as the token it would
# be in source. A `Text` has already decided how it looks and is left alone.
def scalar value
  if (value == nil)
    absent_style "~"
  else if (type value term.Text)
    value
  else if (type value Sym || type value Bool)
    constant_style (str value)
  else if (type value Int || type value Float)
    number_style (str value)
  else if (type value Str)
    literal_style $value
  else
    term.text $value

# Prints the one-line form of `value`, which for an empty block is the marker
# it reads as in place.
def print_inline value
  if (type value Dict)
    print (absent_style "{}")
  else if is_sequence(value)
    print (absent_style "[]")
  else
    print $ scalar $value

# Emits `value` as the body of `key`. `start` is what precedes the line --
# indentation, or a bullet leading into a block -- and `column` is the
# `FmtSpec` that lays the key out against the block it appears in.
def print_entry key value indent start column
  if !is_block(value)
    print $start (key_style(column("$key:"))) " "
    print_inline $value
    print "\n"
    return nil
  # A key that leads into a block is on a line of its own, so it takes no part
  # in the alignment of the keys that share a column with their values.
  print $start (key_style "$key:") "\n"
  print_block $value (indent + 2) (spaces (indent + 2))

# Emits `value` as an item of an enclosing list.
def print_item value indent
  if !is_block(value)
    print $ bullet $indent
    print_inline $value
    print "\n"
    return nil
  if is_sequence(value)
    # Every item of the nested list carries its own bullet, so this one has
    # nothing to lead into and the block opens on the line below.
    print (bullet indent) "\n"
    print_block $value (indent + 2) nil
    return nil
  print_block $value (indent + 2) (bullet indent)

# Emits the children of `value`, one line each. `lead` precedes the first line
# in place of the indentation, so a caller can lead into the block with a key
# or a bullet. A sequence ignores it: every item carries its own bullet.
def print_block value indent lead
  if is_sequence(value)
    for item = value
      print_item $item $indent
    return nil
  let width = 0
  for key item = value
    if !is_block(item)
      let key_width = (key_style (str key)).width()
      if (key_width > width)
        width = key_width
  # The `:` is part of what gets laid out, hence the extra column.
  let column = fmt width: (width + 1)
  let first = true
  for key item = value
    let start = if first
      lead
    else
      spaces $indent
    first = false
    print_entry $key $item $indent $start $column

# --- Leaves -----------------------------------------------------------------

# Renders `value` on one line, with a dim parenthetical aside naming what it
# resolves to.
#
# Ordinary values need no help from this -- the renderer handles them where
# they sit -- so this is for a caller that wants the aside, or that wants a
# structured value flattened to the single line it would otherwise open a
# block on.
pub def text value note = nil
  if (note == nil)
    return scalar $value
  term.text (scalar value) " " (note_style "($note)")

# Renders any iterable of symbols -- every flag type, and every mask a
# security descriptor reports -- as the set of names it holds.
#
# The names are separated the way a mask is usually written rather than the way
# a Do array is: each is an enumerated value in its own right, and reads as one.
pub def flags value
  if (value == nil)
    return scalar nil
  let names = [...value.map(constant_style)]
  if (names.len == 0)
    return absent_style "[]"
  delim_style(" | ").join(names)

# Renders a value that answers to none of the colors: a description this module
# composed, or a string standing in for something that is not one.
pub def plain value note = nil
  text (term.text value) $note

# A number the caller has already written out -- in hex or octal, say -- so
# that it is colored as the number it is rather than the string it arrives as.
pub def number value note = nil
  text (number_style (str value)) $note

# A byte count, scaled to the largest binary unit it fills, with the exact
# number kept as the aside so the size is still readable off the line it is
# scaled on. A count small enough that a unit would only cost it precision is
# left as it is, as is one the caller asked for `raw`.
pub def size value raw = false
  if (value == nil)
    return scalar nil
  let count = term.text (number_style "$value") " bytes"
  if (raw || value < SIZE_STEP)
    return count
  let scaled = float $value
  let unit = nil
  for candidate = SIZE_UNITS
    scaled = (scaled / 1024.0)
    unit = candidate
    if (scaled < SIZE_STEP)
      break
  text $count "${scaled:.2f} $unit"

# --- Sections ---------------------------------------------------------------

# Prints one `▸ name` block, or nothing at all when the section has no content
# to show. A section that could not be read at all arrives as `nil` and reads
# the same way as one that came back empty.
pub def section name node
  if !is_block(node)
    return nil
  print "  " (section_style "▸ $name") "\n"
  print_block $node 6 (spaces 6)

# --- System values ----------------------------------------------------------

# Evaluates `func`, answering `nil` when the value simply isn't there: a field
# that doesn't apply to this platform, an operation the target VFS doesn't
# support, or a query the OS refused.
pub def opt func
  try
    func()
  catch std.FieldError: _
    nil
  catch std.UnsupportedError: _
    nil
  catch sys.Error: _
    nil

# A uid or gid, annotated with the name it resolves to.
pub def id value kind
  if (value == nil)
    return scalar nil
  let name = opt do
    if (kind == :USER:)
      security.unix.user_name $value
    else
      security.unix.group_name $value
  text $value $name

# A Windows SID, annotated with the account it names.
pub def sid value
  if (value == nil)
    return scalar nil
  let name = opt do
    let :kind :qualified_name ... = value.lookup()
    "$kind: $qualified_name"
  text $value $name
