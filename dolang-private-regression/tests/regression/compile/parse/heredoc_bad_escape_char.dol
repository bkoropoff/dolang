# Regression test for issue #2: escape sequences other than \$ and \\ must
# always be rejected in here-docs (previously silently accepted as literal
# text).
let s = |
  x\n
# error: only \$ and \\ escapes are valid in here-docs
#   --> heredoc_bad_escape_char.dol:LL:LL
#    |
# LL |   x\n
#    |    ^^
