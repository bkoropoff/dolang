import std
  std:
    - FieldError
    - ImportError
    - IndexError
    - Iter
    - IterStop
    - MissingPosError
    - Nil
    - Null
    - Sink
    - SinkStop
    - TypeError
    - Value
    - ZeroDivError
    - null
  strand:
    - channel

def assert_err_type ty block
  let res = try
    block()
    false
  catch e
    assert (type e ty)
    true
  assert $res

assert_eq (type 5) $Int
assert_eq (type Int) $Type
assert_eq (type type) $Func
assert_eq (type int) $Func
assert_eq (type float) $Func
assert_eq (type bool) $Func
assert_eq (type str) $Func
assert_eq (type sym) $Func
assert_eq (type array) $Func
assert_eq (type dict) $Func
assert_eq (type tuple) $Func
assert_eq (type record) $Func
assert_err_type $TypeError do Type()
assert_err_type $TypeError do Value()

assert_eq (type 0.5) $Float

assert_eq (type "hello") $Str

assert_eq (type :sym:) $Sym

assert_eq (type nil) $Nil
assert (type nil Nil)
assert (!(type false Nil))
assert_err_type $TypeError do Nil nil

assert_eq (type false) $Bool

assert_eq (type []) $Array

assert_eq (type $ [].iter()) $Iter

assert_eq (type $ [].sink()) $Sink

assert_eq (type {}) $Dict

assert_eq $null $Null
assert_eq (type null) $Type

# Errors
assert_err_type $TypeError do (5 + "hello")
assert_err_type $ZeroDivError do (5 / 0)
assert_err_type $FieldError do std.bad()
assert_err_type $IndexError do [][0]
assert_err_type $MissingPosError do type()
assert_err_type $ImportError do import bad_module: _

let pair = channel()
pair[0].close()
assert_err_type $IterStop do pair[1].next()

pair = channel()
pair[1].close()
assert_err_type $SinkStop do pair[0].put 0
