def assert_err msg block
  let res = try
    block()
    false
  catch e
    assert_eq (str e) $msg
    true
  assert $res

# Existing string operations remain byte-oriented.
assert_eq $"é".len 2
assert_err "invalid UTF-8 substring boundaries" do "é"[0..1]
assert_eq $"éx"[2..] "x"

# Unicode scalar and extended-grapheme views.
let text = "Aé👩‍💻界"
let scalars = text.scalars()
let graphemes = text.graphemes()
assert_eq $scalars.len 7
assert_eq $graphemes.len 4
assert_eq $scalars[0] "A"
assert_eq $scalars[-1] "界"
assert_eq $scalars[1..3] "é"
assert_eq $graphemes[1] "é"
assert_eq $graphemes[2] "👩‍💻"
assert_eq $graphemes[-1] "界"
assert_eq $graphemes[1..3] "é👩‍💻"
assert_eq $graphemes[2..2] ""
assert_err "index out of range or invalid" do scalars[99]
assert_err "index out of range or invalid" do
  graphemes[Range start: 0 end: 3 step: 2]

assert_eq [...scalars] ["A", "e", "́", "👩", "‍", "💻", "界"]
assert_eq [...graphemes] ["A", "é", "👩‍💻", "界"]
assert_eq ("A".scalar()) 65
assert_eq ("́".scalar()) 769
assert_eq ("😀".scalar()) 128512
assert_err "value error: str.scalar: expected exactly one Unicode scalar" do
  "".scalar()
assert_err "value error: str.scalar: expected exactly one Unicode scalar" do
  "é".scalar()
let a b ...rest = text.graphemes()
assert_eq $a "A"
assert_eq $b "é"
assert_eq [...rest] ["👩‍💻", "界"]

# Views and partially-consumed iterators root temporary source strings.
let temporary_view = ("root".repeat 1000).graphemes()
assert_eq $temporary_view[-1] "t"
let temporary_iter = ("👩‍💻x".repeat 1000).graphemes().iter()
assert_eq $temporary_iter.next() "👩‍💻"
let garbage = "z".repeat 100000
assert_eq $garbage.len 100000
assert_eq $temporary_iter.next() "x"

# Display width sums scalar widths per grapheme and caps each grapheme at two.
assert_eq ("abc".width()) 3
assert_eq ("é".width()) 1
assert_eq ("👩‍💻".width()) 2
assert_eq ("界".width()) 2
assert_eq ("\0A".width()) 1
assert_eq ("👩👩".width()) 4

# Clipping is grapheme-aligned and suffixes consume the same total budget.
assert_eq ("abc".clip 3 suffix: "ignored") "abc"
assert_eq ("abc".clip 2) "ab"
assert_eq ("abc".clip 0) ""
assert_eq ("界a".clip 1) ""
assert_eq ("界a".clip 2) "界"
assert_eq ("́a".clip 0) "́"
assert_eq ("abcdef".clip 4 suffix: "…") "abc…"
assert_eq ("abcdef".clip 2 suffix: "界x") "界"
assert_eq ("abcdef".clip 1 suffix: "界x") "a"
assert_err "numeric overflow" do "abc".clip -1
